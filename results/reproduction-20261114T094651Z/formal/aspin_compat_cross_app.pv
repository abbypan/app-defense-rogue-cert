(* Generated by generate_compatible_models.py from aspin_cross_app.pv. K_s is bound by an authenticated installed manifest.
 * Lifecycle checks are shared with the primary model; this file is
 * independently parsed and verified, including manifest provenance. *)

(* App A is installed under a DIFFERENT signing identity from target B.
 * A chooses a package ID, never a root. Only the trusted resolver may bind B
 * to its authenticated policy root. All JWS/certificate inputs use public c.
 * Missing/invisible target is an explicit local resolution-failure outcome.
 * This is the opt-in protected path. A caller's deliberate native-TLS-only
 * fallback lies outside its guarantees. The resolver abstracts the current
 * installed identity at lookup, not concurrent package updates/uninstalls.
 * This verifies certificate-policy authentication, not business authorization. *)
const target_unavailable: bitstring.
const target_available: bitstring.
event CrossAppResolved(bitstring, bitstring, pkey).
event CrossAppPolicy(bitstring, bitstring, pkey, pkey).
event CrossAppNativeValid(bitstring).
event CrossAppConnected(bitstring, bitstring, pkey, bitstring).
event CrossAppData(bitstring, bitstring, pkey, bitstring).
event CrossAppIssuerRejected.
event CrossAppTargetRefused(bitstring).
event CrossAppDelegationPublished(pkey, pkey).

let CrossAppPublisher =
  let root_sk = gen_sk_for_id(self_host_signing) in
  let claim_sk = gen_sk_for_id(claim_signing) in
  let exp = succ_t(succ_t(curr)) in
  event CrossAppDelegationPublished(pk(root_sk), pk(claim_sk));
  out(c, jws_general_sign(pk2s(pk(root_sk)), pk2s(pk(claim_sk)), curr, exp, root_sk));
  out(c, jws_general_sign(pk2s(pk(claim_sk)),
      cert_claim(server_cert_subject_and_san, real_cert_issuer), curr, exp, claim_sk));
  (* The adversary knows A's policy-root private key: authentic B still must
   * not be replaced by caller-owned or attacker-owned signed artifacts. *)
  out(c, gen_sk_for_id(other_self_host_signing)).

let CrossAppServer(server_id: bitstring, issuer: bitstring) =
  let leaf_sk = gen_sk_for_id(server_id) in
  let certificate = gen_cert(pk(leaf_sk), server_cert_subject_and_san, issuer,
      sig_sign(cert_content(pk(leaf_sk), server_cert_subject_and_san, issuer),
          gen_sk_for_id(issuer))) in
  in(c, nonce: bitstring);
  out(c, (certificate, sig_sign((nonce, certificate), leaf_sk))).

let CrossAppVerifier =
  let apk_signer = pk(gen_sk_for_id(other_app_signing)) in
  let apk_manifest = app_manifest(caller_app_id, pk(gen_sk_for_id(other_self_host_signing)), installed_app_version) in
  event AppManifestSigned(caller_app_id, apk_signer, pk(gen_sk_for_id(other_self_host_signing)), installed_app_version);
  let apk_signature = sig_sign(apk_manifest, gen_sk_for_id(other_app_signing)) in
  let (=true) = sig_verify(apk_manifest, apk_signature, apk_signer) in
  event AppManifestAuthenticated(caller_app_id, apk_signer, pk(gen_sk_for_id(other_self_host_signing)), installed_app_version);
  event ManifestKeyBind(caller_app_id, pk(gen_sk_for_id(other_self_host_signing)));
  let caller_record = manifest_key_record(
      caller_app_id, pk(gen_sk_for_id(other_self_host_signing))) in
  let caller_root = resolve_manifest_key(caller_record, caller_app_id) in
  event ManifestKeyResolve(caller_app_id, caller_root);
  let apk_signer = pk(gen_sk_for_id(app_signing)) in
  let apk_manifest = app_manifest(target_app_id, pk(gen_sk_for_id(self_host_signing)), installed_app_version) in
  event AppManifestSigned(target_app_id, apk_signer, pk(gen_sk_for_id(self_host_signing)), installed_app_version);
  let apk_signature = sig_sign(apk_manifest, gen_sk_for_id(app_signing)) in
  let (=true) = sig_verify(apk_manifest, apk_signature, apk_signer) in
  event AppManifestAuthenticated(target_app_id, apk_signer, pk(gen_sk_for_id(self_host_signing)), installed_app_version);
  event ManifestKeyBind(target_app_id, pk(gen_sk_for_id(self_host_signing)));
  let record = manifest_key_record(
      target_app_id, pk(gen_sk_for_id(self_host_signing))) in
  let root = resolve_manifest_key(record, target_app_id) in
  event ManifestKeyResolve(target_app_id, root);
  if caller_root <> root then
  event CrossAppResolved(caller_app_id, target_app_id, root);
  in(c, tk: bitstring);
  let jws_general(hk: bitstring, kp: bitstring, ks: bitstring) = tk in
  let (=true) = header_matches(hk, root) in
  let (=true) = jws_general_verify(tk, root) in
  let kiat = get_iat(kp) in let kexp = get_exp(kp) in
  let delegated = s2pk(get_content(kp)) in
  in(c, tc: bitstring);
  let jws_general(hc: bitstring, cp: bitstring, cs: bitstring) = tc in
  let (=true) = header_matches(hc, delegated) in
  let (=true) = jws_general_verify(tc, delegated) in
  let ciat = get_iat(cp) in let cexp = get_exp(cp) in
  let claim = get_content(cp) in
  let identity = get_subject_and_san(claim) in
  let (=true) = check_host(server_hostname, identity) in
  let authorized = get_issuer(claim) in
  let now = succ_t(curr) in
  let (=true) = token_fresh(kiat, kexp, now) in
  let (=true) = token_fresh(ciat, cexp, now) in
  event CrossAppPolicy(caller_app_id, target_app_id, root, delegated);
  new nonce: bitstring;
  out(c, nonce);
  in(c, (certificate: bitstring, possession: bitstring));
  let gen_cert(leaf: pkey, cert_host: bitstring, issuer: bitstring,
      signature: bitstring) = certificate in
  let (=true) = check_host(server_hostname, cert_host) in
  let (=true) = check_issuer(issuer, system_ca_list) in
  let (=true) = sig_verify(cert_content(leaf, cert_host, issuer), signature,
      pk(gen_sk_for_id(issuer))) in
  let (=true) = sig_verify((nonce, certificate), possession, leaf) in
  event CrossAppNativeValid(issuer);
  if issuer = authorized then
    event CrossAppConnected(caller_app_id, target_app_id, root, issuer);
    event CrossAppData(caller_app_id, target_app_id, root, issuer)
  else event CrossAppIssuerRejected.

query caller: bitstring, target: bitstring, root: pkey, issuer: bitstring,
      delegated: pkey;
  event(CrossAppData(caller, target, root, issuer)) ==>
  event(CrossAppConnected(caller, target, root, issuer)) &&
  event(CrossAppResolved(caller, target, root)) &&
  event(CrossAppPolicy(caller, target, root, delegated)) &&
  event(CrossAppNativeValid(issuer)).
query caller: bitstring, target: bitstring, root: pkey, delegated: pkey;
  event(CrossAppPolicy(caller, target, root, delegated)) ==>
  event(CrossAppDelegationPublished(root, delegated)).
query event(CrossAppData(caller_app_id, target_app_id,
      pk(gen_sk_for_id(self_host_signing)), real_cert_issuer)).
query event(CrossAppIssuerRejected).
query event(CrossAppNativeValid(rogue_cert_issuer)).
query caller: bitstring, target: bitstring, root: pkey;
  event(CrossAppData(caller, target, root, rogue_cert_issuer)).
query delegated: pkey;
  event(CrossAppPolicy(caller_app_id, target_app_id,
      pk(gen_sk_for_id(other_self_host_signing)), delegated)).
query root: pkey;
  event(CrossAppResolved(caller_app_id, caller_app_id, root)).
query event(CrossAppTargetRefused(target_unavailable)).
query root: pkey, issuer: bitstring;
  event(CrossAppData(caller_app_id, target_unavailable, root, issuer)).

query app: bitstring, root: pkey;
  event(ManifestKeyResolve(app, root)) ==> event(ManifestKeyBind(app, root)).
query app: bitstring, root: pkey, signer: pkey, version: bitstring;
  event(ManifestKeyBind(app, root)) ==>
  event(AppManifestAuthenticated(app, signer, root, version)).
query app: bitstring, root: pkey, signer: pkey, version: bitstring;
  event(AppManifestAuthenticated(app, signer, root, version)) ==>
  event(AppManifestSigned(app, signer, root, version)).

process
  CrossAppPublisher | !CrossAppVerifier |
  !CrossAppServer(real_server, real_cert_issuer) |
  !CrossAppServer(rogue_server, rogue_cert_issuer) |
  event CrossAppTargetRefused(target_unavailable)
