(* Generated by generate_compatible_models.py from aspin_availability.pv. K_s is bound by an authenticated installed manifest.
 * Lifecycle checks are shared with the primary model; this file is
 * independently parsed and verified, including manifest provenance. *)

(* Conditional fail-closed safety, NOT an eventual-delivery/liveness proof.
 * Public c carries all candidate JWS/certificates. Local timeout is an explicit
 * outcome of the retrieval abstraction; silence alone is not a pi-calculus
 * timeout. Cases describe observations at protected-clock boundaries, not a
 * global clock imposed on the attacker. No signing keys are compromised. *)
free availability_origin: timestamp.
const available_cached: bitstring.
const unavailable_empty: bitstring.
const unavailable_expired: bitstring.
const available_restored: bitstring.
const replay_after_expiry: bitstring.
const delegation_bound: bitstring.
const claim_bound: bitstring.
event AvailabilityPairPublished(pkey, pkey, timestamp, timestamp).
event AvailabilityReady(bitstring, pkey, timestamp).
event AvailabilityNativeValid(bitstring).
event AvailabilityConnected(bitstring).
event AvailabilityData(bitstring).
event AvailabilityRefused(bitstring).
event AvailabilityCachePrimed(pkey, timestamp).
event AvailabilityExpiredReplayRejected.
event AvailabilityBoundExpired(bitstring).

let AvailabilityPublisher =
  let sk = gen_sk_for_id(self_host_signing) in
  let ck = gen_sk_for_id(claim_signing) in
  let t0 = availability_origin in
  let t2 = succ_t(succ_t(t0)) in
  let t1 = succ_t(t0) in let t3 = succ_t(t2) in
  event AvailabilityPairPublished(pk(sk), pk(ck), t0, t2);
  out(c, jws_general_sign(pk2s(pk(sk)), pk2s(pk(ck)), t0, t2, sk));
  out(c, jws_general_sign(pk2s(pk(ck)),
      cert_claim(server_cert_subject_and_san, real_cert_issuer), t0, t2, ck));
  (* Independent expirations: either T_k or T_c can be the earlier bound. *)
  let t4 = succ_t(succ_t(t2)) in
  out(c, jws_general_sign(pk2s(pk(sk)), pk2s(pk(ck)), t0, t4, sk));
  out(c, jws_general_sign(pk2s(pk(ck)),
      cert_claim(server_cert_subject_and_san, real_cert_issuer), t0, t4, ck));
  event AvailabilityPairPublished(pk(sk), pk(ck), t1, t3);
  out(c, jws_general_sign(pk2s(pk(sk)), pk2s(pk(ck)), t1, t3, sk));
  out(c, jws_general_sign(pk2s(pk(ck)),
      cert_claim(server_cert_subject_and_san, real_cert_issuer), t1, t3, ck));
  let leaf = pk(gen_sk_for_id(real_server)) in
  out(c, gen_cert(leaf, server_cert_subject_and_san, real_cert_issuer,
      sig_sign(cert_content(leaf, server_cert_subject_and_san, real_cert_issuer),
          gen_sk_for_id(real_cert_issuer)))).

let AvailabilityConnection(label: bitstring, owner: pkey, now: timestamp,
    kiat: timestamp, kexp: timestamp, ciat: timestamp, cexp: timestamp) =
  (* The connection gate checks BOTH signed expirations again. *)
  let (=true) = token_fresh(kiat, kexp, now) in
  let (=true) = token_fresh(ciat, cexp, now) in
  event AvailabilityReady(label, owner, now);
  in(c, certificate: bitstring);
  let gen_cert(leaf: pkey, identity: bitstring, issuer: bitstring,
      signature: bitstring) = certificate in
  let (=true) = check_host(server_hostname, identity) in
  let (=true) = check_issuer(issuer, system_ca_list) in
  let (=true) = sig_verify(cert_content(leaf, identity, issuer), signature,
      pk(gen_sk_for_id(issuer))) in
  let (=real_cert_issuer) = issuer in
  event AvailabilityNativeValid(label);
  event AvailabilityConnected(label);
  event AvailabilityData(label).

let AvailabilityClient =
  let apk_signer = pk(gen_sk_for_id(app_signing)) in
  let apk_manifest = app_manifest(target_app_id, pk(gen_sk_for_id(self_host_signing)), installed_app_version) in
  event AppManifestSigned(target_app_id, apk_signer, pk(gen_sk_for_id(self_host_signing)), installed_app_version);
  let apk_signature = sig_sign(apk_manifest, gen_sk_for_id(app_signing)) in
  let (=true) = sig_verify(apk_manifest, apk_signature, apk_signer) in
  event AppManifestAuthenticated(target_app_id, apk_signer, pk(gen_sk_for_id(self_host_signing)), installed_app_version);
  event ManifestKeyBind(target_app_id, pk(gen_sk_for_id(self_host_signing)));
  let record = manifest_key_record(
      target_app_id, pk(gen_sk_for_id(self_host_signing))) in
  let root = resolve_manifest_key(record, target_app_id) in
  event ManifestKeyResolve(target_app_id, root);
  in(c, tk: bitstring);
  let jws_general(hk: bitstring, kp: bitstring, ks: bitstring) = tk in
  let (=true) = header_matches(hk, root) in
  let (=true) = jws_general_verify(tk, root) in
  let kiat = get_iat(kp) in let kexp = get_exp(kp) in
  let delegated = s2pk(get_content(kp)) in
  in(c, tc: bitstring);
  let jws_general(hc: bitstring, cp: bitstring, cs: bitstring) = tc in
  let (=true) = header_matches(hc, delegated) in
  let (=true) = jws_general_verify(tc, delegated) in
  let ciat = get_iat(cp) in let cexp = get_exp(cp) in
  let claim = get_content(cp) in
  let (=true) = check_host(server_hostname, get_subject_and_san(claim)) in
  let (=real_cert_issuer) = get_issuer(claim) in
  let t0 = availability_origin in let t2 = succ_t(succ_t(t0)) in
  (* Prime a genuinely authenticated short-lived cache, not a private token. *)
  let (=t0) = kiat in let (=t0) = ciat in
  if kexp = t2 || cexp = t2 then
  let (=true) = token_fresh(kiat, kexp, t0) in
  let (=true) = token_fresh(ciat, cexp, t0) in
  event AvailabilityCachePrimed(root, t2);
  (
    (* Refresh suppression does not invalidate a fresh cached pair. *)
    AvailabilityConnection(available_cached, root, succ_t(t0), kiat, kexp, ciat, cexp)
  | (* The local refresh has timed out with no usable replacement at exp. *)
    (
    if kexp = t2 then
      event AvailabilityBoundExpired(delegation_bound);
      event AvailabilityRefused(unavailable_expired)
    else
      event AvailabilityBoundExpired(claim_bound);
      event AvailabilityRefused(unavailable_expired)
    )
  | (* At expiry, public-channel replay must not extend the cached lifetime. *)
    (
    in(c, replay: bitstring);
    if replay = tc then
      let (=true) = token_fresh(kiat, kexp, t2) in
      let (=true) = token_fresh(ciat, cexp, t2) in
        AvailabilityConnection(replay_after_expiry, root, t2, kiat, kexp, ciat, cexp)
      else
        event AvailabilityExpiredReplayRejected
      else
        event AvailabilityExpiredReplayRejected
    )
  | (* Restoration is an existential witness, not guaranteed recovery. *)
    in(c, tk2: bitstring);
    let jws_general(hk2: bitstring, kp2: bitstring, ks2: bitstring) = tk2 in
    let (=true) = header_matches(hk2, root) in
    let (=true) = jws_general_verify(tk2, root) in
    let kiat2 = get_iat(kp2) in let kexp2 = get_exp(kp2) in
    let (=true) = iat_not_older(kiat2, kiat) in
    let delegated2 = s2pk(get_content(kp2)) in
    in(c, tc2: bitstring);
    let jws_general(hc2: bitstring, cp2: bitstring, cs2: bitstring) = tc2 in
    let (=true) = header_matches(hc2, delegated2) in
    let (=true) = jws_general_verify(tc2, delegated2) in
    let ciat2 = get_iat(cp2) in let cexp2 = get_exp(cp2) in
    let (=true) = iat_not_older(ciat2, ciat) in
    let claim2 = get_content(cp2) in
    let (=true) = check_host(server_hostname, get_subject_and_san(claim2)) in
    let (=real_cert_issuer) = get_issuer(claim2) in
    AvailabilityConnection(available_restored, root, t2, kiat2, kexp2, ciat2, cexp2)
  ).

query label: bitstring;
  event(AvailabilityData(label)) ==> event(AvailabilityConnected(label)).
query label: bitstring, root: pkey, now: timestamp;
  event(AvailabilityConnected(label)) ==>
  event(AvailabilityReady(label, root, now)) && event(AvailabilityNativeValid(label)).
query root: pkey, now: timestamp, delegated: pkey, iat: timestamp, exp: timestamp;
  event(AvailabilityReady(available_cached, root, now)) ==>
  event(AvailabilityPairPublished(root, delegated, iat, exp)).
query event(AvailabilityData(available_cached)).
query event(AvailabilityData(available_restored)).
query event(AvailabilityRefused(unavailable_empty)).
query event(AvailabilityRefused(unavailable_expired)).
query event(AvailabilityExpiredReplayRejected).
query event(AvailabilityBoundExpired(delegation_bound)).
query event(AvailabilityBoundExpired(claim_bound)).
query event(AvailabilityData(unavailable_empty)).
query event(AvailabilityData(unavailable_expired)).
query event(AvailabilityConnected(unavailable_empty)).
query event(AvailabilityConnected(unavailable_expired)).
query event(AvailabilityData(replay_after_expiry)).

query app: bitstring, root: pkey;
  event(ManifestKeyResolve(app, root)) ==> event(ManifestKeyBind(app, root)).
query app: bitstring, root: pkey, signer: pkey, version: bitstring;
  event(ManifestKeyBind(app, root)) ==>
  event(AppManifestAuthenticated(app, signer, root, version)).
query app: bitstring, root: pkey, signer: pkey, version: bitstring;
  event(AppManifestAuthenticated(app, signer, root, version)) ==>
  event(AppManifestSigned(app, signer, root, version)).

process
  AvailabilityPublisher | !AvailabilityClient |
  (* Empty cache plus explicit failed retrieval: no native-only fallback. *)
  event AvailabilityRefused(unavailable_empty)
