(* Shared-host T_k: one common payload and an unbounded signature list.
 * A and B have different authenticated package roots but use the SAME lookup
 * hostname. Public constructors let the attacker prepend/append any finite
 * number of entries. Recursive membership abstracts selecting an array entry
 * without a length bound; kid never chooses a root. This checks provenance and
 * common-payload binding, not cache lifecycle, byte bounds, or runtime costs. *)

const ms_cohost_signing: bitstring.
const ms_padding_signing: bitstring.
const ms_empty_array: bitstring.
const ms_missing_owner: bitstring.
const ms_forged_kid: bitstring.
const ms_spliced_payload: bitstring.
const ms_wrong_delegation: bitstring.

event MultiSigContext(bitstring, bitstring, pkey).
event MultiSigDelegation(pkey, pkey, timestamp, timestamp).
event MultiSigArrayAccepted(pkey, jws_signature_list).
event MultiSigClaim(bitstring, pkey, pkey, bitstring, timestamp, timestamp).
event MultiSigAuditRejected(bitstring).
event MultiSigAuditBypass(bitstring).

let MultiSigPublisher =
  let a = gen_sk_for_id(other_app_signing) in
  let b = gen_sk_for_id(app_signing) in
  let cohost = gen_sk_for_id(ms_cohost_signing) in
  let delegated = gen_sk_for_id(claim_signing) in
  let payload = jws_payload(pk2s(pk(delegated)), curr, succ_t(succ_t(curr))) in
  event ClaimKeySign(a, pk(delegated), curr, succ_t(succ_t(curr)));
  event ClaimKeySign(b, pk(delegated), curr, succ_t(succ_t(curr)));
  event ClaimKeySign(cohost, pk(delegated), curr, succ_t(succ_t(curr)));
  (* B's context-matching entry is third, beyond the removed two-entry cap. *)
  let signatures = jws_signature_cons(jws_sign_entry(pk2s(pk(a)), payload, a),
      jws_signature_cons(jws_sign_entry(pk2s(pk(cohost)), payload, cohost),
      jws_signature_cons(jws_sign_entry(pk2s(pk(b)), payload, b), jws_no_signatures))) in
  out(c, jws_signature_array(payload, signatures));
  let claim = cert_claim(server_cert_subject_and_san, real_cert_issuer) in
  event CertClaimSign(delegated, server_cert_subject_and_san, real_cert_issuer,
      curr, succ_t(succ_t(curr)));
  out(c, jws_general_sign(pk2s(pk(delegated)), claim,
      curr, succ_t(succ_t(curr)), delegated));
  (* Untrusted padding signatures may be created freely, but they cannot
   * authorize either installed app's root. *)
  out(c, gen_sk_for_id(ms_padding_signing)).

let MultiSigTargetVerifier =
  let record = package_signing_record(
      target_app_id, pk(gen_sk_for_id(app_signing))) in
  let root = resolve_os_key(record, target_app_id) in
  event MultiSigContext(target_app_id, server_hostname, root);
  in(c, tk: bitstring);
  let jws_signature_array(payload: bitstring, entries: jws_signature_list) = tk in
  new reply: channel;
  out(jws_signature_scan, (payload, entries, root, reply));
  in(reply, (=true));
  let kiat = get_iat(payload) in
  let kexp = get_exp(payload) in
  let delegated = s2pk(get_content(payload)) in
  let now = succ_t(curr) in
  let (=true) = token_fresh(kiat, kexp, now) in
  event ClaimKeyVerify(root, delegated, kiat, kexp);
  event MultiSigDelegation(root, delegated, kiat, kexp);
  event MultiSigArrayAccepted(root, entries);
  in(c, tc: bitstring);
  let jws_general(hc: bitstring, pc: bitstring, sc: bitstring) = tc in
  let (=true) = header_matches(hc, delegated) in
  let (=true) = jws_general_verify(tc, delegated) in
  let ciat = get_iat(pc) in
  let cexp = get_exp(pc) in
  let (=true) = token_fresh(ciat, cexp, now) in
  let identity = get_subject_and_san(get_content(pc)) in
  let (=true) = check_host(server_hostname, identity) in
  let issuers = get_issuer(get_content(pc)) in
  event CertClaimVerify(delegated, identity, issuers, ciat, cexp);
  event MultiSigClaim(target_app_id, root, delegated, issuers, ciat, cexp).

let MultiSigCallerVerifier =
  let record = package_signing_record(
      caller_app_id, pk(gen_sk_for_id(other_app_signing))) in
  let root = resolve_os_key(record, caller_app_id) in
  event MultiSigContext(caller_app_id, server_hostname, root);
  in(c, tk: bitstring);
  let jws_signature_array(payload: bitstring, entries: jws_signature_list) = tk in
  new reply: channel;
  out(jws_signature_scan, (payload, entries, root, reply));
  in(reply, (=true));
  let kiat = get_iat(payload) in
  let kexp = get_exp(payload) in
  let delegated = s2pk(get_content(payload)) in
  let (=true) = token_fresh(kiat, kexp, succ_t(curr)) in
  event ClaimKeyVerify(root, delegated, kiat, kexp);
  event MultiSigDelegation(root, delegated, kiat, kexp).

(* These negative controls contain zero or one entry. Decomposing that finite
 * list directly avoids relying on negative user-predicate trace reconstruction.
 * The header/signature checks are the scanner's same checks. The public-input
 * verifiers above separately check provenance for arbitrary-length lists. *)
let MultiSigAudit(label: bitstring, payload: bitstring, entries: jws_signature_list) =
  let record = package_signing_record(
      target_app_id, pk(gen_sk_for_id(app_signing))) in
  let root = resolve_os_key(record, target_app_id) in
  if entries = jws_no_signatures then event MultiSigAuditRejected(label) else
  let jws_signature_cons(entry: bitstring, =jws_no_signatures) = entries in
  let jws_signature_entry(header: bitstring, signature: bitstring) = entry in
  (
    let (=true) = header_matches(header, root) in
    (
      let (=true) = sig_verify(jws_tosign(header, payload), signature, root) in
        event MultiSigAuditBypass(label)
      else event MultiSigAuditRejected(label)
    )
    else event MultiSigAuditRejected(label)
  ).

query root_sk: skey, delegated: pkey, iat: timestamp, exp: timestamp;
  event(ClaimKeyVerify(pk(root_sk), delegated, iat, exp)) ==>
  event(ClaimKeySign(root_sk, delegated, iat, exp)).
query claim_sk: skey, identity: bitstring, issuers: bitstring,
      iat: timestamp, exp: timestamp;
  event(CertClaimVerify(pk(claim_sk), identity, issuers, iat, exp)) ==>
  event(CertClaimSign(claim_sk, identity, issuers, iat, exp)).
query app: bitstring, root: pkey, delegated: pkey, issuers: bitstring,
      iat: timestamp, exp: timestamp;
  event(MultiSigClaim(app, root, delegated, issuers, iat, exp)) ==>
  event(MultiSigContext(app, server_hostname, root)).
query event(MultiSigDelegation(pk(gen_sk_for_id(app_signing)),
    pk(gen_sk_for_id(claim_signing)), curr, succ_t(succ_t(curr)))).
query event(MultiSigDelegation(pk(gen_sk_for_id(other_app_signing)),
    pk(gen_sk_for_id(claim_signing)), curr, succ_t(succ_t(curr)))).
query first: bitstring, second: bitstring, third: bitstring;
  event(MultiSigArrayAccepted(pk(gen_sk_for_id(app_signing)),
      jws_signature_cons(jws_signature_entry(pk2s(pk(gen_sk_for_id(other_app_signing))), first),
      jws_signature_cons(jws_signature_entry(pk2s(pk(gen_sk_for_id(ms_cohost_signing))), second),
      jws_signature_cons(jws_signature_entry(pk2s(pk(gen_sk_for_id(app_signing))), third),
          jws_no_signatures))))).
query event(MultiSigClaim(target_app_id, pk(gen_sk_for_id(app_signing)),
    pk(gen_sk_for_id(claim_signing)), real_cert_issuer, curr, succ_t(succ_t(curr)))).
query delegated: pkey, issuer: bitstring, iat: timestamp, exp: timestamp;
  event(MultiSigClaim(target_app_id, pk(gen_sk_for_id(other_app_signing)),
      delegated, issuer, iat, exp)).
query root: pkey, delegated: pkey, iat: timestamp, exp: timestamp;
  event(MultiSigClaim(target_app_id, root, delegated, rogue_cert_issuer, iat, exp)).
query event(MultiSigAuditRejected(ms_empty_array)).
query event(MultiSigAuditRejected(ms_missing_owner)).
query event(MultiSigAuditRejected(ms_forged_kid)).
query event(MultiSigAuditRejected(ms_spliced_payload)).
query label: bitstring; event(MultiSigAuditBypass(label)).

process
  let b = gen_sk_for_id(app_signing) in
  let wrong = gen_sk_for_id(ms_padding_signing) in
  let payload = jws_payload(pk2s(pk(gen_sk_for_id(claim_signing))),
      curr, succ_t(succ_t(curr))) in
  let other_payload = jws_payload(pk2s(pk(gen_sk_for_id(ms_wrong_delegation))),
      curr, succ_t(succ_t(curr))) in
  MultiSigPublisher | !MultiSigTargetVerifier | !MultiSigCallerVerifier |
  !GeneralJwsSignatureScanner |
  MultiSigAudit(ms_empty_array, payload, jws_no_signatures) |
  MultiSigAudit(ms_missing_owner, payload, jws_signature_cons(
      jws_sign_entry(pk2s(pk(wrong)), payload, wrong), jws_no_signatures)) |
  MultiSigAudit(ms_forged_kid, payload, jws_signature_cons(
      jws_sign_entry(pk2s(pk(b)), payload, wrong), jws_no_signatures)) |
  MultiSigAudit(ms_spliced_payload, other_payload, jws_signature_cons(
      jws_sign_entry(pk2s(pk(b)), payload, b), jws_no_signatures))
