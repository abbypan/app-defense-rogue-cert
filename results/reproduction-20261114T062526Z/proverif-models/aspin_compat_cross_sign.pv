(* Generated by generate_compatible_models.py from aspin_cross_sign.pv. K_s is bound by an authenticated installed manifest.
 * Lifecycle checks are shared with the primary model; this file is
 * independently parsed and verified, including manifest provenance. *)

(* One intermediate public key/Subject has two distinct CA certificates,
 * signed by different trusted roots. Hashes denote complete DER certificates,
 * not the shared public key or issuer Name. The selected, natively validated
 * direct issuer alone is checked; peer-supplied extras cannot authorize it.
 * An earlier, deliberately incomplete policy is a negative-control fixture.
 * This model adds no certificate-path-construction or anti-rollback proof. *)

free cross_sign_origin: timestamp.
free cross_sign_time: channel [private].
const cs_root_a: bitstring.
const cs_root_b: bitstring.
const cs_shared_ca_key: bitstring.
const cs_wrong_ca_key: bitstring.
const cs_ca_subject: bitstring.
const cs_variant_a: bitstring.
const cs_variant_b: bitstring.
const cs_variant_rogue: bitstring.
const cs_complete_policy: bitstring.
const cs_incomplete_policy: bitstring.
const cs_no_extra: bitstring.

fun cs_ca_content(pkey, bitstring, bitstring, bitstring): bitstring [data].
fun cs_ca_certificate(pkey, bitstring, bitstring, bitstring, bitstring): bitstring [data].
fun cs_der_hash(bitstring): bitstring.
fun cs_pair(bitstring, bitstring): bitstring [data].
fun cs_single(bitstring): bitstring [data].
reduc forall a: bitstring, b: bitstring; cs_contains(a, cs_pair(a, b)) = true;
      forall a: bitstring, b: bitstring; cs_contains(b, cs_pair(a, b)) = true;
      forall a: bitstring; cs_contains(a, cs_single(a)) = true.
reduc forall a: bitstring, b: bitstring; cs_policy_label(cs_pair(a, b)) = cs_complete_policy;
      forall a: bitstring; cs_policy_label(cs_single(a)) = cs_incomplete_policy.
reduc cs_trusted_root(cs_root_a) = true; cs_trusted_root(cs_root_b) = true.
fun cs_leaf_content(pkey, bitstring, bitstring): bitstring [data].
fun cs_leaf_certificate(pkey, bitstring, bitstring): bitstring [data].
fun cs_possession(bitstring, bitstring): bitstring [data].

event CrossSignPolicyVerified(pkey, bitstring).
event CrossSignNativeValidated(bitstring, bitstring).
event CrossSignAccepted(bitstring, bitstring, bitstring).
event CrossSignRejected(bitstring, bitstring, bitstring).
event CrossSignPaddingRejected(bitstring, bitstring).
event CrossSignExpired(timestamp).

let CrossSignPublisher(ca_a: bitstring, ca_b: bitstring) =
  let root_sk = gen_sk_for_id(self_host_signing) in
  let delegated_sk = gen_sk_for_id(claim_signing) in
  let iat = cross_sign_origin in
  let exp = succ_t(succ_t(succ_t(iat))) in
  let key_exp = succ_t(exp) in
  let complete = cs_pair(cs_der_hash(ca_a), cs_der_hash(ca_b)) in
  let incomplete = cs_single(cs_der_hash(ca_a)) in
  let tk = jws_general_sign(pk2s(pk(root_sk)), pk2s(pk(delegated_sk)),
      iat, key_exp, root_sk) in
  event ClaimKeySign(root_sk, pk(delegated_sk), iat, key_exp);
  let tc_partial = jws_general_sign(pk2s(pk(delegated_sk)),
      cert_claim(server_cert_subject_and_san, incomplete), iat, exp, delegated_sk) in
  event CertClaimSign(delegated_sk, server_cert_subject_and_san, incomplete, iat, exp);
  let tc_full = jws_general_sign(pk2s(pk(delegated_sk)),
      cert_claim(server_cert_subject_and_san, complete), succ_t(iat), exp, delegated_sk) in
  event CertClaimSign(delegated_sk, server_cert_subject_and_san, complete, succ_t(iat), exp);
  out(c, tk); out(c, tc_partial); out(c, tc_full);
  (out(cross_sign_time, succ_t(iat)) | out(cross_sign_time, exp)).

let CrossSignServer(direct: bitstring, ca_key_id: bitstring, extra: bitstring) =
  let leaf_sk = gen_sk_for_id(real_server) in
  let leaf = cs_leaf_certificate(pk(leaf_sk), server_cert_subject_and_san,
      sig_sign(cs_leaf_content(pk(leaf_sk), server_cert_subject_and_san, cs_ca_subject),
          gen_sk_for_id(ca_key_id))) in
  in(c, challenge: bitstring);
  out(c, (leaf, direct, extra, sig_sign(cs_possession(challenge, leaf), leaf_sk))).

let CrossSignVerifier =
  in(cross_sign_time, now: timestamp);
  let apk_signer = pk(gen_sk_for_id(app_signing)) in
  let apk_manifest = app_manifest(target_app_id, pk(gen_sk_for_id(self_host_signing)), installed_app_version) in
  event AppManifestSigned(target_app_id, apk_signer, pk(gen_sk_for_id(self_host_signing)), installed_app_version);
  let apk_signature = sig_sign(apk_manifest, gen_sk_for_id(app_signing)) in
  let (=true) = sig_verify(apk_manifest, apk_signature, apk_signer) in
  event AppManifestAuthenticated(target_app_id, apk_signer, pk(gen_sk_for_id(self_host_signing)), installed_app_version);
  event ManifestKeyBind(target_app_id, pk(gen_sk_for_id(self_host_signing)));
  let record = manifest_key_record(
      target_app_id, pk(gen_sk_for_id(self_host_signing))) in
  let root = resolve_manifest_key(record, target_app_id) in
  event ManifestKeyResolve(target_app_id, root);
  in(c, tk: bitstring);
  let jws_general(hk: bitstring, payload_k: bitstring, sigk: bitstring) = tk in
  let (=true) = header_matches(hk, root) in
  let (=true) = jws_general_verify(tk, root) in
  let kiat = get_iat(payload_k) in
  let kexp = get_exp(payload_k) in
  let delegated = s2pk(get_content(payload_k)) in
  let (=true) = token_fresh(kiat, kexp, now) in
  in(c, tc: bitstring);
  let jws_general(hc: bitstring, payload_c: bitstring, sigc: bitstring) = tc in
  let (=true) = header_matches(hc, delegated) in
  let (=true) = jws_general_verify(tc, delegated) in
  let ciat = get_iat(payload_c) in
  let cexp = get_exp(payload_c) in
  let claim = get_content(payload_c) in
  let identity = get_subject_and_san(claim) in
  let (=true) = check_host(server_hostname, identity) in
  let issuers = get_issuer(claim) in
  let (=true) = token_fresh(ciat, cexp, now) in
  (
    event ClaimKeyVerify(root, delegated, kiat, kexp);
    event CertClaimVerify(delegated, identity, issuers, ciat, cexp);
    let policy = cs_policy_label(issuers) in
    event CrossSignPolicyVerified(root, policy);
    new challenge: bitstring;
    out(c, challenge);
    in(c, (leaf: bitstring, direct: bitstring, extra: bitstring, possession: bitstring));
    let cs_ca_certificate(ca_key: pkey, =cs_ca_subject, anchor: bitstring,
        variant: bitstring, ca_signature: bitstring) = direct in
    let (=true) = cs_trusted_root(anchor) in
    let (=true) = sig_verify(cs_ca_content(ca_key, cs_ca_subject, anchor, variant),
        ca_signature, pk(gen_sk_for_id(anchor))) in
    let cs_leaf_certificate(leaf_key: pkey, peer_identity: bitstring,
        leaf_signature: bitstring) = leaf in
    let (=true) = check_host(server_hostname, peer_identity) in
    let (=true) = sig_verify(cs_leaf_content(leaf_key, peer_identity, cs_ca_subject),
        leaf_signature, ca_key) in
    let (=true) = sig_verify(cs_possession(challenge, leaf), possession, leaf_key) in
    event CrossSignNativeValidated(policy, variant);
    let (=true) = cs_contains(cs_der_hash(direct), issuers) in
      event CrossSignAccepted(policy, variant, extra)
    else
      event CrossSignRejected(policy, variant, extra);
      if extra <> cs_no_extra then
        event CrossSignPaddingRejected(policy, variant)
  )
  else
    let (=true) = token_expired(cexp, now) in
    event CrossSignExpired(now).

query root_sk: skey, delegated: pkey, iat: timestamp, exp: timestamp;
  event(ClaimKeyVerify(pk(root_sk), delegated, iat, exp)) ==>
  event(ClaimKeySign(root_sk, delegated, iat, exp)).
query claim_sk: skey, identity: bitstring, issuers: bitstring, iat: timestamp, exp: timestamp;
  event(CertClaimVerify(pk(claim_sk), identity, issuers, iat, exp)) ==>
  event(CertClaimSign(claim_sk, identity, issuers, iat, exp)).
query root: pkey, policy: bitstring, variant: bitstring, extra: bitstring;
  event(CrossSignAccepted(policy, variant, extra)) ==> event(CrossSignPolicyVerified(root, policy)).
query policy: bitstring, variant: bitstring, extra: bitstring;
  event(CrossSignAccepted(policy, variant, extra)) ==> event(CrossSignNativeValidated(policy, variant)).
query event(CrossSignAccepted(cs_complete_policy, cs_variant_a, cs_no_extra)).
query event(CrossSignAccepted(cs_complete_policy, cs_variant_b, cs_no_extra)).
query event(CrossSignAccepted(cs_incomplete_policy, cs_variant_a, cs_no_extra)).
query extra: bitstring; event(CrossSignAccepted(cs_incomplete_policy, cs_variant_b, extra)).
query policy: bitstring, extra: bitstring; event(CrossSignAccepted(policy, cs_variant_rogue, extra)).
query extra: bitstring; event(CrossSignRejected(cs_incomplete_policy, cs_variant_b, extra)).
query extra: bitstring; event(CrossSignRejected(cs_complete_policy, cs_variant_rogue, extra)).
query event(CrossSignExpired(succ_t(succ_t(succ_t(cross_sign_origin))))).
(* Non-vacuous controls distinguish a native-valid unauthorized issuer from
 * an unrelated native-TLS failure, with and without peer-list padding. *)
query event(CrossSignNativeValidated(cs_complete_policy, cs_variant_rogue)).
query event(CrossSignRejected(cs_complete_policy, cs_variant_rogue, cs_no_extra)).
query event(CrossSignPaddingRejected(cs_complete_policy, cs_variant_rogue)).

query app: bitstring, root: pkey;
  event(ManifestKeyResolve(app, root)) ==> event(ManifestKeyBind(app, root)).
query app: bitstring, root: pkey, signer: pkey, version: bitstring;
  event(ManifestKeyBind(app, root)) ==>
  event(AppManifestAuthenticated(app, signer, root, version)).
query app: bitstring, root: pkey, signer: pkey, version: bitstring;
  event(AppManifestAuthenticated(app, signer, root, version)) ==>
  event(AppManifestSigned(app, signer, root, version)).

process
  let shared_key = pk(gen_sk_for_id(cs_shared_ca_key)) in
  let wrong_key = pk(gen_sk_for_id(cs_wrong_ca_key)) in
  let ca_a = cs_ca_certificate(shared_key, cs_ca_subject, cs_root_a, cs_variant_a,
      sig_sign(cs_ca_content(shared_key, cs_ca_subject, cs_root_a, cs_variant_a),
          gen_sk_for_id(cs_root_a))) in
  let ca_b = cs_ca_certificate(shared_key, cs_ca_subject, cs_root_b, cs_variant_b,
      sig_sign(cs_ca_content(shared_key, cs_ca_subject, cs_root_b, cs_variant_b),
          gen_sk_for_id(cs_root_b))) in
  let ca_rogue = cs_ca_certificate(wrong_key, cs_ca_subject, cs_root_a, cs_variant_rogue,
      sig_sign(cs_ca_content(wrong_key, cs_ca_subject, cs_root_a, cs_variant_rogue),
          gen_sk_for_id(cs_root_a))) in
  out(c, ca_a); out(c, ca_b); out(c, ca_rogue);
  CrossSignPublisher(ca_a, ca_b) | !CrossSignVerifier |
  !CrossSignServer(ca_a, cs_shared_ca_key, cs_no_extra) |
  !CrossSignServer(ca_b, cs_shared_ca_key, cs_no_extra) |
  !CrossSignServer(ca_rogue, cs_wrong_ca_key, cs_no_extra) |
  !CrossSignServer(ca_rogue, cs_wrong_ca_key, ca_a)
