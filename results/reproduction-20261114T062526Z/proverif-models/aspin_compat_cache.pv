(* Generated by generate_compatible_models.py from aspin_cache.pv. K_s is bound by an authenticated installed manifest.
 * Lifecycle checks are shared with the primary model; this file is
 * independently parsed and verified, including manifest provenance. *)

(*
 * ASPin cache, CA migration, freshness, rollback, and emergency-update model.
 * It follows paper_content.tex, Sections sec:tkv, sec:tcv, and sec:cache.
 *
 * Every token is retrieved from public channel c, under full Dolev--Yao
 * control.  Private phase channels carry only liveness schedule signals; they
 * never deliver a token or bypass verification.
 *)

const new_cert_issuer: bitstring.
const window_current: bitstring.
const window_overlap: bitstring.
const window_new_cert: bitstring.
const claim_current_ca: bitstring.
const claim_transition_ca: bitstring.
const claim_new_ca: bitstring.
const token_type_claim: bitstring.
const token_type_key: bitstring.
free migration_time_0: timestamp.
free migration_key_delivery: channel [private].
free migration_current_delivery: channel [private].
free migration_overlap_delivery: channel [private].
free migration_cutover_delivery: channel [private].
free migration_final_delivery: channel [private].

fun migration_claim(bitstring, bitstring): bitstring [data].
reduc forall identity: bitstring, issuers: bitstring;
      get_migration_identity(migration_claim(identity, issuers)) = identity.
reduc forall identity: bitstring, issuers: bitstring;
      get_migration_issuers(migration_claim(identity, issuers)) = issuers.

reduc issuer_allowed(real_cert_issuer, claim_current_ca) = true;
      issuer_allowed(real_cert_issuer, claim_transition_ca) = true;
      issuer_allowed(new_cert_issuer, claim_transition_ca) = true;
      issuer_allowed(new_cert_issuer, claim_new_ca) = true.

(* A T_c cache entry binds the target's verified signing identity and the
 * delegated claim key that authenticated it to the signed Subject/SAN and
 * Issuer content.  The requested hostname is not a T_c cache field; every
 * lookup checks it against the cached signed identity and requires a fresh
 * hostname-local T_k entry that yields the same delegated key.  Entries can
 * be read immediately, or one step later only for a two-step freshness
 * window; there is no reduction for now = exp. *)
fun claim_key_cache_entry(
    pkey, bitstring, pkey, timestamp, timestamp): bitstring [private].
reduc forall app_key: pkey, host: bitstring, claim_key: pkey,
             iat: timestamp, exp: timestamp;
      read_cached_claim_key(
          claim_key_cache_entry(app_key, host, claim_key, iat, exp),
          app_key, host, iat) = claim_key;
      forall app_key2: pkey, host2: bitstring, claim_key2: pkey,
             iat2: timestamp;
      read_cached_claim_key(
          claim_key_cache_entry(
              app_key2, host2, claim_key2, iat2, succ_t(succ_t(iat2))),
          app_key2, host2, succ_t(iat2)) = claim_key2;
      forall app_key3: pkey, host3: bitstring, claim_key3: pkey,
             iat3: timestamp;
      read_cached_claim_key(
          claim_key_cache_entry(
              app_key3, host3, claim_key3, iat3,
              succ_t(succ_t(succ_t(succ_t(iat3))))),
          app_key3, host3, succ_t(iat3)) = claim_key3;
      forall app_key4: pkey, host4: bitstring, claim_key4: pkey,
             iat4: timestamp;
      read_cached_claim_key(
          claim_key_cache_entry(
              app_key4, host4, claim_key4, iat4,
              succ_t(succ_t(succ_t(succ_t(iat4))))),
          app_key4, host4, succ_t(succ_t(iat4))) = claim_key4;
      forall app_key5: pkey, host5: bitstring, claim_key5: pkey,
             iat5: timestamp;
      read_cached_claim_key(
          claim_key_cache_entry(
              app_key5, host5, claim_key5, iat5,
              succ_t(succ_t(succ_t(succ_t(iat5))))),
          app_key5, host5, succ_t(succ_t(succ_t(iat5)))) = claim_key5.

fun cache_entry(
    pkey, pkey, bitstring, timestamp, timestamp): bitstring [private].
reduc forall app_key: pkey, claim_key: pkey, content: bitstring,
             iat: timestamp, exp: timestamp;
      read_cached_claim(
          cache_entry(app_key, claim_key, content, iat, exp),
          app_key, claim_key, iat) = content;
      forall app_key2: pkey, claim_key2: pkey, content2: bitstring,
             iat2: timestamp;
      read_cached_claim(
          cache_entry(
              app_key2, claim_key2, content2, iat2, succ_t(succ_t(iat2))),
          app_key2, claim_key2, succ_t(iat2)) = content2.

event MigrationClaimPublished(
    bitstring, pkey, bitstring, bitstring, timestamp, timestamp).
event MigrationClaimCached(
    bitstring, pkey, bitstring, bitstring, bitstring, timestamp, timestamp).
event MigrationClaimReturned(
    bitstring, pkey, bitstring, bitstring, bitstring, timestamp, timestamp).
event MigrationClaimAuthenticated(
    pkey, bitstring, bitstring, timestamp, timestamp).
event MigrationNewCertObtained(bitstring).
event MigrationTransitionAvailable(bitstring).
event MigrationPhaseElapsed(bitstring, timestamp).
(* One event represents joint activation of paper T_c^(3) and NewCert. *)
event MigrationJointCutover(bitstring, bitstring, bitstring).
event MigrationWindowComplete(bitstring).
event MigrationCertAccepted(bitstring, bitstring, bitstring).
event MigrationPolicyPairAllowed(bitstring, bitstring).
event CrossSigningKeyCacheHit(pkey, pkey, bitstring).
event CrossDelegationCacheHit(pkey, pkey, bitstring).
event CrossHostnameCacheHit(bitstring, bitstring, pkey).
event EmergencyReplacementPublished(bitstring, timestamp).
event EmergencyReplacementAccepted(bitstring, timestamp).
event TargetOwnerResolved(bitstring, bitstring, pkey).

let MigrationServer =
  (* Internal indices 0..2 correspond to paper windows w1..w3. *)
  let sk_app = gen_sk_for_id(self_host_signing) in
  let sk_claim = gen_sk_for_id(claim_signing) in
  let app_key = pk(sk_app) in
  let claim_key = pk(sk_claim) in
  let iat0 = migration_time_0 in
  let iat1 = succ_t(iat0) in
  let iat2 = succ_t(iat1) in

  (* T_k authenticates K_cpub and its validity interval. *)
  let key_exp = succ_t(succ_t(succ_t(succ_t(iat0)))) in
  let token_k = jws_general_sign(
      pk2s(app_key), pk2s(claim_key), iat0, key_exp, sk_app) in
  event ClaimKeySign(sk_app, claim_key, iat0, key_exp);
  out(c, token_k);
  out(migration_key_delivery, window_current);

  (* Paper w1: CurrCert and CurrCA-only claim. *)
  let exp0 = succ_t(iat0) in
  let content0 = migration_claim(
      server_cert_subject_and_san, claim_current_ca) in
  let token_c_0 = jws_general_sign(
      pk2s(claim_key), content0, iat0, exp0, sk_claim) in
  event MigrationClaimPublished(
      window_current, app_key, server_cert_subject_and_san,
      claim_current_ca, iat0, exp0);
  out(c, token_c_0);
  out(migration_current_delivery, window_current);

  (* Obtain but do not deploy NewCert; paper w2 still deploys CurrCert and
   * publishes one dual-issuer CurrCA/NewCA staging policy. *)
  event MigrationNewCertObtained(new_cert_issuer);
  (* Phase advance occurs only at the complete modeled L_max boundary. *)
  let (=true) = token_expired(exp0, iat1) in
  (* The model instantiates L_max as one symbolic step.  The paper-w2
   * publication remains current for one complete maximum T_c lifetime before
   * joint paper-w3 activation at iat2. *)
  let exp1 = succ_t(iat1) in
  let transition_c_1 = migration_claim(
      server_cert_subject_and_san, claim_transition_ca) in
  let token_c_1 = jws_general_sign(
      pk2s(claim_key), transition_c_1, iat1, exp1, sk_claim) in
  event MigrationClaimPublished(
      window_overlap, app_key, server_cert_subject_and_san,
      claim_transition_ca, iat1, exp1);
  event MigrationTransitionAvailable(window_overlap);
  out(c, token_c_1);
  out(migration_overlap_delivery, window_overlap);

  (* Only paper w3 deploys NewCert.  After w2's complete modeled L_max, final
   * NewCA-only claim publication and NewCert deployment form one coordinated
   * symbolic transition at iat2, with no intermediate honest window. *)
  let (=true) = token_expired(exp1, iat2) in
  event MigrationPhaseElapsed(window_overlap, iat2);
  let exp2 = succ_t(iat2) in
  let content2 = migration_claim(
      server_cert_subject_and_san, claim_new_ca) in
  let token_c_2 = jws_general_sign(
      pk2s(claim_key), content2, iat2, exp2, sk_claim) in
  event MigrationClaimPublished(
      window_new_cert, app_key, server_cert_subject_and_san,
      claim_new_ca, iat2, exp2);
  event MigrationJointCutover(
      window_new_cert, new_cert_issuer, claim_new_ca);
  out(c, token_c_2);
  out(migration_cutover_delivery, new_cert_issuer);
  out(migration_final_delivery, window_new_cert)
  .

let UpdatingVerifier =
  (* App A names App B.  Only the protected OS resolver supplies B's
   * signing key; the caller neither supplies nor selects key material. *)
  let apk_signer = pk(gen_sk_for_id(app_signing)) in
  let apk_manifest = app_manifest(target_app_id, pk(gen_sk_for_id(self_host_signing)), installed_app_version) in
  event AppManifestSigned(target_app_id, apk_signer, pk(gen_sk_for_id(self_host_signing)), installed_app_version);
  let apk_signature = sig_sign(apk_manifest, gen_sk_for_id(app_signing)) in
  let (=true) = sig_verify(apk_manifest, apk_signature, apk_signer) in
  event AppManifestAuthenticated(target_app_id, apk_signer, pk(gen_sk_for_id(self_host_signing)), installed_app_version);
  event ManifestKeyBind(target_app_id, pk(gen_sk_for_id(self_host_signing)));
  let target_record = manifest_key_record(
      target_app_id, pk(gen_sk_for_id(self_host_signing))) in
  let app_key = resolve_manifest_key(target_record, target_app_id) in
  event ManifestKeyResolve(target_app_id, app_key);
  event TargetOwnerResolved(caller_app_id, target_app_id, app_key);

  (* ClaimKeyVerify at setup. *)
  in(migration_key_delivery, =window_current);
  in(c, jws_general(hk: bitstring, key_payload: bitstring, sigk: bitstring));
  let key_iat = get_iat(key_payload) in
  let key_exp = get_exp(key_payload) in
  let (=true) = header_matches(hk, app_key) in
  let (=true) = jws_general_verify(jws_general(hk, key_payload, sigk), app_key) in
  let (=true) = token_fresh(key_iat, key_exp, migration_time_0) in
  let (=ttl_four) = derive_ttl(key_iat, key_exp) in
  let claim_key = s2pk(get_content(key_payload)) in
  event ClaimKeyVerify(app_key, claim_key, key_iat, key_exp);
  let key_cache = claim_key_cache_entry(
      app_key, server_hostname, claim_key, key_iat, key_exp) in

  (* Paper w1: authenticate, bind, cache, and use CurrCA claim. *)
  in(migration_current_delivery, =window_current);
  in(c, jws_general(h0: bitstring, p0: bitstring, s0: bitstring));
  let iat0 = get_iat(p0) in
  let exp0 = get_exp(p0) in
  let (=true) = header_matches(h0, claim_key) in
  let (=true) = jws_general_verify(jws_general(h0, p0, s0), claim_key) in
  let (=true) = token_fresh(iat0, exp0, iat0) in
  let (=ttl_one) = derive_ttl(iat0, exp0) in
  let (=migration_time_0) = iat0 in
  let (=succ_t(migration_time_0)) = exp0 in
  let content0 = get_content(p0) in
  let identity0 = get_migration_identity(content0) in
  let (=server_cert_subject_and_san) = identity0 in
  let (=true) = check_host(server_hostname, identity0) in
  let issuers0 = get_migration_issuers(content0) in
  let (=claim_current_ca) = issuers0 in
  event MigrationClaimCached(
      window_current, app_key, server_hostname, identity0,
      issuers0, iat0, exp0);
  event MigrationClaimAuthenticated(
      app_key, identity0, issuers0, iat0, exp0);
  let cached_claim_key0 = read_cached_claim_key(
      key_cache, app_key, server_hostname, iat0) in
  let cache0 = cache_entry(
      app_key, claim_key, content0, iat0, exp0) in
  let returned0 = read_cached_claim(
      cache0, app_key, cached_claim_key0, iat0) in
  let (=true) = check_host(
      server_hostname, get_migration_identity(returned0)) in
  event MigrationClaimReturned(
      window_current, app_key, server_hostname,
      get_migration_identity(returned0), issuers0, iat0, exp0);
  let (=true) = issuer_allowed(real_cert_issuer, issuers0) in
  event MigrationCertAccepted(
      window_current, real_cert_issuer, issuers0);
  event MigrationWindowComplete(window_current);

  (* Paper w2: strictly later iat and transitional CurrCA/NewCA claim. *)
  in(migration_overlap_delivery, =window_overlap);
  in(c, jws_general(h1: bitstring, p1: bitstring, s1: bitstring));
  let iat1 = get_iat(p1) in
  let exp1 = get_exp(p1) in
  let (=true) = header_matches(h1, claim_key) in
  let (=true) = jws_general_verify(jws_general(h1, p1, s1), claim_key) in
  let (=true) = token_fresh(iat1, exp1, iat1) in
  let (=true) = token_fresh(key_iat, key_exp, iat1) in
  let (=true) = iat_not_older(iat1, iat0) in
  let (=true) = iat_older(iat0, iat1) in
  let (=succ_t(iat0)) = iat1 in
  let (=ttl_one) = derive_ttl(iat1, exp1) in
  let (=succ_t(iat1)) = exp1 in
  let content1 = get_content(p1) in
  let identity1 = get_migration_identity(content1) in
  let (=server_cert_subject_and_san) = identity1 in
  let (=true) = check_host(server_hostname, identity1) in
  let issuers1 = get_migration_issuers(content1) in
  let (=claim_transition_ca) = issuers1 in
  event MigrationClaimCached(
      window_overlap, app_key, server_hostname, identity1,
      issuers1, iat1, exp1);
  event MigrationClaimAuthenticated(
      app_key, identity1, issuers1, iat1, exp1);
  let cached_claim_key1 = read_cached_claim_key(
      key_cache, app_key, server_hostname, iat1) in
  let cache1 = cache_entry(
      app_key, claim_key, content1, iat1, exp1) in
  let returned1 = read_cached_claim(
      cache1, app_key, cached_claim_key1, iat1) in
  let (=true) = check_host(
      server_hostname, get_migration_identity(returned1)) in
  event MigrationClaimReturned(
      window_overlap, app_key, server_hostname,
      get_migration_identity(returned1), issuers1, iat1, exp1);
  let (=true) = issuer_allowed(real_cert_issuer, issuers1) in
  event MigrationCertAccepted(
      window_overlap, real_cert_issuer, issuers1);
  event MigrationWindowComplete(window_overlap);

  (* Enter paper w3 only after paper w2's complete modeled L_max.  Its
   * transition claim is expired at the boundary and is not used to accept
   * NewCert; coordinated w3 activation makes the final NewCA-only JWS and
   * NewCert available in the same symbolic phase. *)
  in(migration_cutover_delivery, =new_cert_issuer);
  let cutover_time = succ_t(iat1) in
  let (=true) = token_expired(exp1, cutover_time) in
  let (=true) = token_fresh(key_iat, key_exp, cutover_time) in

  (* Paper w3: retrieve the NewCA-only claim activated by the same coordinated
   * transition that enables NewCert. *)
  in(migration_final_delivery, =window_new_cert);
  in(c, jws_general(h2: bitstring, p2: bitstring, s2: bitstring));
  let iat2 = get_iat(p2) in
  let exp2 = get_exp(p2) in
  let (=true) = header_matches(h2, claim_key) in
  let (=true) = jws_general_verify(jws_general(h2, p2, s2), claim_key) in
  let (=true) = token_fresh(iat2, exp2, iat2) in
  let (=true) = token_fresh(key_iat, key_exp, iat2) in
  let (=true) = iat_not_older(iat2, iat1) in
  let (=true) = iat_older(iat1, iat2) in
  let (=succ_t(iat1)) = iat2 in
  let (=ttl_one) = derive_ttl(iat2, exp2) in
  let (=succ_t(iat2)) = exp2 in
  let content2 = get_content(p2) in
  let identity2 = get_migration_identity(content2) in
  let (=server_cert_subject_and_san) = identity2 in
  let (=true) = check_host(server_hostname, identity2) in
  let issuers2 = get_migration_issuers(content2) in
  let (=claim_new_ca) = issuers2 in
  event MigrationClaimCached(
      window_new_cert, app_key, server_hostname, identity2,
      issuers2, iat2, exp2);
  event MigrationClaimAuthenticated(
      app_key, identity2, issuers2, iat2, exp2);
  let cached_claim_key2 = read_cached_claim_key(
      key_cache, app_key, server_hostname, iat2) in
  let cache2 = cache_entry(
      app_key, claim_key, content2, iat2, exp2) in
  let returned2 = read_cached_claim(
      cache2, app_key, cached_claim_key2, iat2) in
  let (=true) = check_host(
      server_hostname, get_migration_identity(returned2)) in
  event MigrationClaimReturned(
      window_new_cert, app_key, server_hostname,
      get_migration_identity(returned2), issuers2, iat2, exp2);
  let (=true) = issuer_allowed(new_cert_issuer, issuers2) in
  event MigrationCertAccepted(
      window_new_cert, new_cert_issuer, issuers2);
  event MigrationWindowComplete(window_new_cert)
  .

(* Explicit structural audits: a correctly bound cache entry has no reduction
 * under a different target signing identity, and its signed identity cannot satisfy
 * another requested hostname.  The API caller is deliberately not a cache
 * input; App A may select App B, after which the OS supplies B's signing key.
 * Packages resolving to the same signing key intentionally share this owner. *)
let CrossSigningKeyCacheAudit =
  let apk_signer = pk(gen_sk_for_id(app_signing)) in
  let apk_manifest = app_manifest(target_app_id, pk(gen_sk_for_id(self_host_signing)), installed_app_version) in
  event AppManifestSigned(target_app_id, apk_signer, pk(gen_sk_for_id(self_host_signing)), installed_app_version);
  let apk_signature = sig_sign(apk_manifest, gen_sk_for_id(app_signing)) in
  let (=true) = sig_verify(apk_manifest, apk_signature, apk_signer) in
  event AppManifestAuthenticated(target_app_id, apk_signer, pk(gen_sk_for_id(self_host_signing)), installed_app_version);
  event ManifestKeyBind(target_app_id, pk(gen_sk_for_id(self_host_signing)));
  let target_record = manifest_key_record(
      target_app_id, pk(gen_sk_for_id(self_host_signing))) in
  let apk_signer = pk(gen_sk_for_id(other_app_signing)) in
  let apk_manifest = app_manifest(caller_app_id, pk(gen_sk_for_id(other_self_host_signing)), installed_app_version) in
  event AppManifestSigned(caller_app_id, apk_signer, pk(gen_sk_for_id(other_self_host_signing)), installed_app_version);
  let apk_signature = sig_sign(apk_manifest, gen_sk_for_id(other_app_signing)) in
  let (=true) = sig_verify(apk_manifest, apk_signature, apk_signer) in
  event AppManifestAuthenticated(caller_app_id, apk_signer, pk(gen_sk_for_id(other_self_host_signing)), installed_app_version);
  event ManifestKeyBind(caller_app_id, pk(gen_sk_for_id(other_self_host_signing)));
  let caller_record = manifest_key_record(
      caller_app_id, pk(gen_sk_for_id(other_self_host_signing))) in
  let app_key = resolve_manifest_key(target_record, target_app_id) in
  event ManifestKeyResolve(target_app_id, app_key);
  let other_key = resolve_manifest_key(caller_record, caller_app_id) in
  event ManifestKeyResolve(caller_app_id, other_key);
  let iat = migration_time_0 in
  let exp = succ_t(succ_t(iat)) in
  let claim_key = pk(gen_sk_for_id(claim_signing)) in
  let content = migration_claim(
      server_cert_subject_and_san, claim_current_ca) in
  let entry = cache_entry(app_key, claim_key, content, iat, exp) in
  let result = read_cached_claim(entry, other_key, claim_key, iat) in
  event CrossSigningKeyCacheHit(app_key, other_key, result)
  .

let CrossDelegationCacheAudit =
  let apk_signer = pk(gen_sk_for_id(app_signing)) in
  let apk_manifest = app_manifest(target_app_id, pk(gen_sk_for_id(self_host_signing)), installed_app_version) in
  event AppManifestSigned(target_app_id, apk_signer, pk(gen_sk_for_id(self_host_signing)), installed_app_version);
  let apk_signature = sig_sign(apk_manifest, gen_sk_for_id(app_signing)) in
  let (=true) = sig_verify(apk_manifest, apk_signature, apk_signer) in
  event AppManifestAuthenticated(target_app_id, apk_signer, pk(gen_sk_for_id(self_host_signing)), installed_app_version);
  event ManifestKeyBind(target_app_id, pk(gen_sk_for_id(self_host_signing)));
  let target_record = manifest_key_record(
      target_app_id, pk(gen_sk_for_id(self_host_signing))) in
  let app_key = resolve_manifest_key(target_record, target_app_id) in
  event ManifestKeyResolve(target_app_id, app_key);
  let claim_key = pk(gen_sk_for_id(claim_signing)) in
  let other_claim_key = pk(gen_sk_for_id(other_self_host_signing)) in
  let iat = migration_time_0 in
  let exp = succ_t(succ_t(iat)) in
  let content = migration_claim(
      server_cert_subject_and_san, claim_current_ca) in
  let entry = cache_entry(app_key, claim_key, content, iat, exp) in
  let result = read_cached_claim(
      entry, app_key, other_claim_key, iat) in
  event CrossDelegationCacheHit(claim_key, other_claim_key, result)
  .

let CrossHostnameCacheAudit =
  let apk_signer = pk(gen_sk_for_id(app_signing)) in
  let apk_manifest = app_manifest(target_app_id, pk(gen_sk_for_id(self_host_signing)), installed_app_version) in
  event AppManifestSigned(target_app_id, apk_signer, pk(gen_sk_for_id(self_host_signing)), installed_app_version);
  let apk_signature = sig_sign(apk_manifest, gen_sk_for_id(app_signing)) in
  let (=true) = sig_verify(apk_manifest, apk_signature, apk_signer) in
  event AppManifestAuthenticated(target_app_id, apk_signer, pk(gen_sk_for_id(self_host_signing)), installed_app_version);
  event ManifestKeyBind(target_app_id, pk(gen_sk_for_id(self_host_signing)));
  let target_record = manifest_key_record(
      target_app_id, pk(gen_sk_for_id(self_host_signing))) in
  let app_key = resolve_manifest_key(target_record, target_app_id) in
  event ManifestKeyResolve(target_app_id, app_key);
  let iat = migration_time_0 in
  let exp = succ_t(succ_t(iat)) in
  let claim_key = pk(gen_sk_for_id(claim_signing)) in
  let content = migration_claim(
      server_cert_subject_and_san, claim_current_ca) in
  let entry = cache_entry(app_key, claim_key, content, iat, exp) in
  let result = read_cached_claim(entry, app_key, claim_key, iat) in
  let (=true) = check_host(
      other_hostname, get_migration_identity(result)) in
  event CrossHostnameCacheHit(server_hostname, other_hostname, app_key)
  .

(* Audit issuer-set semantics independently of the honest deployment schedule.
 * The first two branches block because those certificate/policy pairs are
 * incompatible.  The third reaches its event because a dual transition policy
 * intentionally authorizes the NewCA identifier before honest-server cutover. *)
let MigrationPolicyAudit =
  (
    let (=true) = issuer_allowed(
        new_cert_issuer, claim_current_ca) in
    event MigrationPolicyPairAllowed(
        new_cert_issuer, claim_current_ca)
  ) |
  (
    let (=true) = issuer_allowed(
        real_cert_issuer, claim_new_ca) in
    event MigrationPolicyPairAllowed(
        real_cert_issuer, claim_new_ca)
  ) |
  (
    let (=true) = issuer_allowed(
        new_cert_issuer, claim_transition_ca) in
    event MigrationPolicyPairAllowed(
        new_cert_issuer, claim_transition_ca)
  )
  .

(* A replayed token can remain fresh yet be rejected solely because its iat is
 * below protected highest-seen state.  The same replacement removes CurrCA. *)
let RollbackAndEmergencyScenario =
  let sk_claim = gen_sk_for_id(claim_signing) in
  let claim_key = pk(sk_claim) in
  let old_iat = migration_time_0 in
  let new_iat = succ_t(old_iat) in
  let common_exp = succ_t(succ_t(old_iat)) in
  let old_content = migration_claim(
      server_cert_subject_and_san, claim_current_ca) in
  let old_token = jws_general_sign(
      pk2s(claim_key), old_content, old_iat, common_exp, sk_claim) in
  let new_content = migration_claim(
      server_cert_subject_and_san, claim_new_ca) in
  let new_token = jws_general_sign(
      pk2s(claim_key), new_content, new_iat, common_exp, sk_claim) in
  event EmergencyReplacementPublished(claim_new_ca, new_iat);
  out(c, old_token);
  out(c, new_token);
  let jws_general(new_h: bitstring, new_p: bitstring, new_s: bitstring) = new_token in
  let (=true) = header_matches(new_h, claim_key) in
  let (=true) = jws_general_verify(new_token, claim_key) in
  let (=true) = token_fresh(new_iat, common_exp, new_iat) in
  let new_identity = get_migration_identity(get_content(new_p)) in
  let (=true) = check_host(server_hostname, new_identity) in
  let (=true) = iat_not_older(new_iat, old_iat) in
  event EmergencyReplacementAccepted(claim_new_ca, new_iat);
  (* Attacker replay: signature and freshness still pass at new_iat. *)
  let jws_general(old_h: bitstring, old_p: bitstring, old_s: bitstring) = old_token in
  let (=true) = header_matches(old_h, claim_key) in
  let (=true) = jws_general_verify(old_token, claim_key) in
  let (=true) = token_fresh(old_iat, common_exp, new_iat) in
  let old_identity = get_migration_identity(get_content(old_p)) in
  let (=true) = check_host(server_hostname, old_identity) in
  let (=true) = iat_older(old_iat, new_iat) in
  event RollbackRejected(token_type_claim, old_iat, new_iat);
  event EmergencyTokenRevoked(claim_current_ca, new_iat)
  .

(* Routine T_k replacement uses the same protected highest-seen rule as T_c.
 * All structural, header, signature, and freshness checks precede the state
 * comparison and update. *)
let ClaimKeyRollbackScenario =
  let sk_app = gen_sk_for_id(self_host_signing) in
  let app_key = pk(sk_app) in
  let claim_key = pk(gen_sk_for_id(claim_signing)) in
  let old_iat = migration_time_0 in
  let new_iat = succ_t(old_iat) in
  let common_exp = succ_t(succ_t(old_iat)) in
  let old_token = jws_general_sign(
      pk2s(app_key), pk2s(claim_key), old_iat, common_exp, sk_app) in
  let new_token = jws_general_sign(
      pk2s(app_key), pk2s(claim_key), new_iat, common_exp, sk_app) in
  out(c, old_token);
  out(c, new_token);
  let jws_general(new_h: bitstring, new_p: bitstring, new_s: bitstring) = new_token in
  let (=true) = header_matches(new_h, app_key) in
  let (=true) = jws_general_verify(new_token, app_key) in
  let (=true) = token_fresh(new_iat, common_exp, new_iat) in
  let new_claim_key = s2pk(get_content(new_p)) in
  let (=claim_key) = new_claim_key in
  let (=true) = iat_not_older(new_iat, old_iat) in
  let jws_general(old_h: bitstring, old_p: bitstring, old_s: bitstring) = old_token in
  let (=true) = header_matches(old_h, app_key) in
  let (=true) = jws_general_verify(old_token, app_key) in
  let (=true) = token_fresh(old_iat, common_exp, new_iat) in
  let old_claim_key = s2pk(get_content(old_p)) in
  let (=claim_key) = old_claim_key in
  let (=true) = iat_older(old_iat, new_iat) in
  event RollbackRejected(token_type_key, old_iat, new_iat)
  .

let FreezeDefenseScenario =
  let sk_claim = gen_sk_for_id(claim_signing) in
  let claim_key = pk(sk_claim) in
  let iat = migration_time_0 in
  let exp = succ_t(iat) in
  let token = jws_general_sign(
      pk2s(claim_key),
      migration_claim(server_cert_subject_and_san, claim_current_ca),
      iat, exp, sk_claim) in
  out(c, token);
  let (=true) = jws_general_verify(token, claim_key) in
  let (=true) = token_expired(exp, exp) in
  event ExpiredTokenRejected(token_type_claim, exp, exp)
  .

(* Authenticated cache contents retain the target app key, signed server
 * identity, issuer policy, iat, and exp.  Hostname is a checked lookup input,
 * not a cached trust attribute. *)
query w: bitstring, key: pkey, host: bitstring, identity: bitstring,
      claim: bitstring, iat: timestamp, exp: timestamp;
  event(MigrationClaimCached(
      w, key, host, identity, claim, iat, exp)) ==>
  event(MigrationClaimPublished(
      w, key, identity, claim, iat, exp)).
query w: bitstring, key: pkey, host: bitstring, identity: bitstring,
      claim: bitstring, iat: timestamp, exp: timestamp;
  event(MigrationClaimReturned(
      w, key, host, identity, claim, iat, exp)) ==>
  event(MigrationClaimAuthenticated(
      key, identity, claim, iat, exp)).

(* Required migration ordering and final-policy provenance. *)
query event(MigrationJointCutover(
    window_new_cert, new_cert_issuer, claim_new_ca)) ==>
  event(MigrationNewCertObtained(new_cert_issuer)).
query event(MigrationJointCutover(
    window_new_cert, new_cert_issuer, claim_new_ca)) ==>
  event(MigrationTransitionAvailable(window_overlap)).
query event(MigrationJointCutover(
    window_new_cert, new_cert_issuer, claim_new_ca)) ==>
  event(MigrationPhaseElapsed(
      window_overlap, succ_t(succ_t(migration_time_0)))).
query event(MigrationCertAccepted(
    window_new_cert, new_cert_issuer, claim_new_ca)) ==>
  event(MigrationJointCutover(
      window_new_cert, new_cert_issuer, claim_new_ca)).

(* The first and third acceptances are policy-incompatible.  The middle one is
 * policy-compatible but excluded by the encoded honest deployment schedule:
 * NewCert is not enabled while a dual transition claim remains fresh. *)
query event(MigrationCertAccepted(
    window_new_cert, new_cert_issuer, claim_current_ca)).
query event(MigrationCertAccepted(
    window_new_cert, new_cert_issuer, claim_transition_ca)).
query event(MigrationCertAccepted(
    window_new_cert, real_cert_issuer, claim_new_ca)).

(* Policy compatibility independent of deployment-window reachability. *)
query event(MigrationPolicyPairAllowed(
    new_cert_issuer, claim_current_ca)).
query event(MigrationPolicyPairAllowed(
    real_cert_issuer, claim_new_ca)).
query event(MigrationPolicyPairAllowed(
    new_cert_issuer, claim_transition_ca)).

(* Cross-index cache reuse remains unreachable. *)
query old_key: pkey, new_key: pkey, content: bitstring;
  event(CrossSigningKeyCacheHit(old_key, new_key, content)).
query old_key: pkey, new_key: pkey, content: bitstring;
  event(CrossDelegationCacheHit(old_key, new_key, content)).
query expected: bitstring, requested: bitstring, key: pkey;
  event(CrossHostnameCacheHit(expected, requested, key)).

(* Rollback/freeze/emergency properties are reachable and causally grounded. *)
query token_type: bitstring, old_iat: timestamp, highest_iat: timestamp;
  event(RollbackRejected(token_type, old_iat, highest_iat)).
query event(RollbackRejected(
    token_type_claim, migration_time_0, succ_t(migration_time_0))).
query event(RollbackRejected(
    token_type_key, migration_time_0, succ_t(migration_time_0))).
query token_type: bitstring, exp: timestamp, now: timestamp;
  event(ExpiredTokenRejected(token_type, exp, now)).
query revoked: bitstring, replacement_iat: timestamp;
  event(EmergencyTokenRevoked(revoked, replacement_iat)).
query claim: bitstring, iat: timestamp;
  event(EmergencyReplacementAccepted(claim, iat)) ==>
  event(EmergencyReplacementPublished(claim, iat)).

(* Every operational window and legitimate certificate combination is live. *)
query event(MigrationWindowComplete(window_current)).
query event(MigrationWindowComplete(window_overlap)).
query event(MigrationWindowComplete(window_new_cert)).
query event(MigrationCertAccepted(
    window_current, real_cert_issuer, claim_current_ca)).
query event(MigrationCertAccepted(
    window_overlap, real_cert_issuer, claim_transition_ca)).
query event(MigrationCertAccepted(
    window_new_cert, new_cert_issuer, claim_new_ca)).

query event(MigrationWindowComplete(window_current)) ==>
  event(MigrationCertAccepted(
      window_current, real_cert_issuer, claim_current_ca)).
query event(MigrationWindowComplete(window_overlap)) ==>
  event(MigrationCertAccepted(
      window_overlap, real_cert_issuer, claim_transition_ca)).
query event(MigrationWindowComplete(window_new_cert)) ==>
  event(MigrationCertAccepted(
      window_new_cert, new_cert_issuer, claim_new_ca)).

query app: bitstring, root: pkey;
  event(ManifestKeyResolve(app, root)) ==> event(ManifestKeyBind(app, root)).
query app: bitstring, root: pkey, signer: pkey, version: bitstring;
  event(ManifestKeyBind(app, root)) ==>
  event(AppManifestAuthenticated(app, signer, root, version)).
query app: bitstring, root: pkey, signer: pkey, version: bitstring;
  event(AppManifestAuthenticated(app, signer, root, version)) ==>
  event(AppManifestSigned(app, signer, root, version)).

process
  MigrationServer | UpdatingVerifier |
  MigrationPolicyAudit |
  CrossSigningKeyCacheAudit | CrossDelegationCacheAudit |
  CrossHostnameCacheAudit |
  RollbackAndEmergencyScenario | ClaimKeyRollbackScenario |
  FreezeDefenseScenario
