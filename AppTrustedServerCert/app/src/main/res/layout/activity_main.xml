<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:scrollbarStyle="outsideOverlay"
    android:scrollbarSize="12dp"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- App Title -->
    <TextView
        android:id="@+id/appTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="App Certificate &amp; HTTPS Demo"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="#e1f5fe"
        android:padding="16dp"
        android:elevation="4dp" />

    <!-- Max Benchmark Attempt Number Input -->
    <EditText
        android:id="@+id/maxBenchmarkAttemptNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="1000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#f3e5f5"
        android:padding="8dp"
        android:hint="Enter number of benchmark iterations (default: 1000)"
        android:inputType="number"
        android:selectAllOnFocus="true" />

    <EditText
        android:id="@+id/hostTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
              android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#e3f2fd"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:hint="Enter server hostname (e.g., appservercert.run.place)"
        android:inputType="textUri"
        android:selectAllOnFocus="true" />

    <EditText
        android:id="@+id/dcpHostTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#e8f5e9"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:hint="Enter DCP hostname (e.g., dcp.run.place)"
        android:inputType="textUri"
        android:selectAllOnFocus="true" />

    <EditText
        android:id="@+id/expIssuerTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#fff3e0"
        android:padding="8dp"
        android:layout_marginBottom="16dp"
        android:hint="Enter expected issuer"
        android:inputType="text"
        android:selectAllOnFocus="true" />

    <EditText
        android:id="@+id/expSPKTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#f1f8e9"
        android:padding="8dp"
        android:layout_marginBottom="16dp"
        android:hint="Enter expected subject public key hash"
        android:inputType="text"
        android:selectAllOnFocus="true" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/GetHTTPContentButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Get HTTP Content"
            android:textSize="14sp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/GetAndVerifyClaimButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Get And Verify ASPRoC"
            android:textSize="14sp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <Button
        android:id="@+id/GetAndVerifyDCPButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Get And Verify DCP"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <!-- JWT Benchmark Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/JwtCskBenchmarkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Claim Signing Key Benchmark"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:background="#4CAF50"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/JwtSccBenchmarkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Server Cert Claim Benchmark"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:background="#FF9800"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/DCPBenchmarkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DCP Benchmark"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:background="#795548"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <!-- HTTPS Connection Benchmark Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/httpsDefaultConnectionBenchmarkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HTTPS Conn Benchmark"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:background="#2196F3"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <!-- HTTPS ASPRoC/DCP Connection Benchmark Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/httpsASPRoCConnectionBenchmarkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ASPRoC Conn Benchmark"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:background="#FF5722"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/httpsDCPConnectionBenchmarkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DCP Conn Benchmark"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:background="#009688"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <!-- HTTPS Create Conn Benchmark Button -->
    <Button
        android:id="@+id/getJwtCskBenchmarkButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Get Tk Benchmark"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"
        android:background="#9C27B0"
        android:textColor="@android:color/white" />

    <!-- Get Cert Claim JWT Benchmark Button -->
    <Button
        android:id="@+id/getJwtSccBenchmarkButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Get Tc Benchmark"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"
        android:background="#607D8B"
        android:textColor="@android:color/white" />

    <!-- Combined Response View -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbarSize="10dp"
        android:fadeScrollbars="false">

        <TextView
            android:id="@+id/responseTextView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#f5f5f5"
            android:fontFamily="monospace"
            android:lines="20"
            android:padding="12dp"
            android:text="Click a button above to make HTTPS request or show app information"
            android:textIsSelectable="true"
            android:textSize="14sp" />

    </ScrollView>

</LinearLayout>

</ScrollView>
