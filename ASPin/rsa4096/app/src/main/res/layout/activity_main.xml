<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:scrollbarStyle="outsideOverlay"
    android:scrollbarSize="12dp"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/hostTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#e3f2fd"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:hint="Enter server hostname"
        android:inputType="textUri"
        android:selectAllOnFocus="true" />

    <EditText
        android:id="@+id/expIssuerTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#fff3e0"
        android:padding="8dp"
        android:layout_marginBottom="16dp"
        android:hint="Authenticated issuer identifier(s)"
        android:inputType="text"
        android:selectAllOnFocus="true" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/GetHTTPContentButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Get Index Page"
            android:textSize="14sp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/GetAndVerifyClaimButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Get ASPin"
            android:textSize="14sp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <Button
        android:id="@+id/ConnectASPinButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect with ASPin"
        android:layout_marginBottom="8dp" />

    <!-- Connection or OS claim result -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbarSize="10dp"
        android:fadeScrollbars="false">

        <TextView
            android:id="@+id/responseTextView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#f5f5f5"
            android:fontFamily="monospace"
            android:lines="20"
            android:padding="12dp"
            android:text="Click a button above to make HTTPS request or show app information"
            android:textIsSelectable="true"
            android:textSize="14sp" />

    </ScrollView>

</LinearLayout>

</ScrollView>
