<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:scrollbarStyle="outsideOverlay"
    android:scrollbarSize="12dp"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Max Benchmark Attempt Number Input -->
    <EditText
        android:id="@+id/maxBenchmarkAttemptNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="2000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#f3e5f5"
        android:padding="8dp"
        android:hint="Enter number of benchmark iterations (default: 2000)"
        android:inputType="number"
        android:selectAllOnFocus="true" />

    <EditText
        android:id="@+id/hostTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#e3f2fd"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:hint="Enter server hostname"
        android:inputType="textUri"
        android:selectAllOnFocus="true" />

    <EditText
        android:id="@+id/dcpHostTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#e8f5e9"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:hint="Enter DCP hostname"
        android:inputType="textUri"
        android:selectAllOnFocus="true" />

    <EditText
        android:id="@+id/expIssuerTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#fff3e0"
        android:padding="8dp"
        android:layout_marginBottom="16dp"
        android:hint="Enter expected issuer"
        android:inputType="text"
        android:selectAllOnFocus="true" />

    <EditText
        android:id="@+id/expSPKTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#f1f8e9"
        android:padding="8dp"
        android:layout_marginBottom="16dp"
        android:hint="Enter expected subject public key hash"
        android:inputType="text"
        android:selectAllOnFocus="true" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/GetHTTPContentButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Get Index Page"
            android:textSize="14sp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/GetAndVerifyClaimButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Get ASPin"
            android:textSize="14sp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <Button
        android:id="@+id/GetAndVerifyDCPButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Get DCP"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

        <!-- Table 2 AvgVisitTime Benchmark Button -->
    <Button
        android:id="@+id/AvgVisitTimeBenchmarkButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AvgVisitTime Benchmark (Table 2: StandardTLS vs ASPin vs SCP vs DCP)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:background="#3F51B5"
        android:textColor="@android:color/white" />

    <!-- Table 1 Benchmark Button -->
    <Button
        android:id="@+id/AvgVerifTimeBenchmarkButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AvgVerifTime Benchmark (Table 1)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:background="#9C27B0"
        android:textColor="@android:color/white" />

    <!-- JWT Benchmark Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/JwtCskBenchmarkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CSK Benchmark"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:background="#4CAF50"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/JwtSccBenchmarkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SCC Benchmark"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:background="#FF9800"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/DCPBenchmarkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DCP Benchmark"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:background="#795548"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <!-- HTTPS Connection Benchmark Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/httpsDefaultConnectionBenchmarkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HTTPS Conn Benchmark"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:background="#2196F3"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <!-- HTTPS SCP/ASPin/DCP Connection Benchmark Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/httpsSCPConnectionBenchmarkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SCP Conn Benchmark"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:background="#673AB7"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/httpsASPinConnectionBenchmarkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ASPin Conn Benchmark"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:background="#FF5722"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/httpsDCPConnectionBenchmarkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DCP Conn Benchmark"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:background="#009688"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <!-- Combined Response View -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbarSize="10dp"
        android:fadeScrollbars="false">

        <TextView
            android:id="@+id/responseTextView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#f5f5f5"
            android:fontFamily="monospace"
            android:lines="20"
            android:padding="12dp"
            android:text="Click a button above to make HTTPS request or show app information"
            android:textIsSelectable="true"
            android:textSize="14sp" />

    </ScrollView>

</LinearLayout>

</ScrollView>
