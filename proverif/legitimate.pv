
set attacker = active.
(*set attacker = passive.*)

(* events *)
event jwt_claim_signing_key_create(pkey, pkey, timestamp).
event jwt_claim_signing_key_verify(pkey, pkey, timestamp).
event jwt_server_cert_claim_create(pkey, bitstring, bitstring, timestamp).
event jwt_server_cert_claim_verify(pkey, bitstring, bitstring, timestamp).

event jwt_server_cert_claim_say(bitstring, bitstring).
event jwt_server_cert_claim_approve(bitstring, bitstring).

event app_server_tls(bitstring, bitstring, bitstring, bitstring).
event app_client_tls(bitstring, bitstring, bitstring, bitstring).



let AppServer =
  let header = pk2s(pk(sk_app_signing)) in
  let good_exp = succ_t(curr) in
  let content = pk2s(pk(sk_claim_signing)) in
  let token = jwt_sign(header, content, good_exp, sk_app_signing) in
  event jwt_claim_signing_key_create(pk(sk_app_signing), pk(sk_claim_signing), good_exp);
  out(c, token);
  let header2 = pk2s(pk(sk_claim_signing)) in
  let good_exp2 = succ_t(curr) in
  let content2 = cert_claim(server_cert_subject_and_san, server_cert_issuer) in
  let token2 = jwt_sign(header2, content2, good_exp2, sk_claim_signing) in
  event jwt_server_cert_claim_create(pk(sk_claim_signing), server_cert_subject_and_san, server_cert_issuer, good_exp2);
  event jwt_server_cert_claim_say(server_cert_subject_and_san, server_cert_issuer);
  out(c, token2);
  let msg3 = tls_server(server_hostname, server_ip,  server_mechine, server_cert_subject_and_san, server_cert_issuer, sensitive_data) in
  event app_server_tls(server_hostname, server_cert_subject_and_san, server_cert_issuer, sensitive_data);
  out(c, msg3)
  .

let LegitimateApp =
  in(c, jwt(h: bitstring, plr: bitstring, sr: bitstring));
  let pk_app_signing = pk(sk_app_signing) in
  let content = get_content(plr) in
  let pk1_recv = s2pk(content) in 
  let exp_recv = get_exp(plr) in
  if jwt_verify(jwt(h, plr, sr), pk_app_signing, curr) = true then
      event jwt_claim_signing_key_verify(pk(sk_app_signing), pk1_recv, exp_recv);
       
  in(c, jwt(h2: bitstring, plr2: bitstring, sr2: bitstring)); 
  let content2 = get_content(plr2) in
  let subject_and_san2 = get_subject_and_san(content2) in
  let issuer2 = get_issuer(content2) in
  let exp2 = get_exp(plr2) in
  if jwt_verify(jwt(h2, plr2, sr2), pk1_recv, curr) = true then
      event jwt_server_cert_claim_verify(pk1_recv, subject_and_san2, issuer2, exp2);
      event jwt_server_cert_claim_approve(subject_and_san2, issuer2);
  
  in(c, tls_server(hostn, sip, smech, subj_and_san_recv, iss, sens_d));
  if (check_host(hostn, subject_and_san2) = host_true) &&
     (check_host(hostn, subj_and_san_recv) = host_true) && (issuer2 = iss) then
     event app_client_tls(hostn, subj_and_san_recv, issuer2, sens_d)
  .
 




query attacker(sensitive_data).   

query event(app_client_tls(server_hostname, server_cert_subject_and_san, server_cert_issuer, sensitive_data)). 


query app_pk: pkey, claim_pk: pkey, exp: timestamp;
  event(jwt_claim_signing_key_verify(app_pk, claim_pk, exp)) ==> event(jwt_claim_signing_key_create(app_pk, claim_pk, exp)).

query claim_pk: pkey, subject_and_san: bitstring, issuer: bitstring, exp: timestamp;
  event(jwt_server_cert_claim_verify(claim_pk, subject_and_san, issuer, exp)) ==> event(jwt_server_cert_claim_create(claim_pk, subject_and_san, issuer, exp))
  .

query hostn: bitstring, subj_and_san: bitstring, iss: bitstring, sens_d: bitstring;
      event(app_client_tls(hostn, subj_and_san, iss, sens_d)) ==> event(jwt_server_cert_claim_approve(subj_and_san, iss)).

query hostn: bitstring, subj_and_san: bitstring, iss: bitstring, sens_d: bitstring;
      event(app_client_tls(hostn, subj_and_san, iss, sens_d)) ==> event(jwt_server_cert_claim_say(subj_and_san, iss)).



query event(app_client_tls(server_hostname, server_cert_subject_and_san, server_cert_issuer, sensitive_data)) ==>
      event(app_server_tls(server_hostname, server_cert_subject_and_san, server_cert_issuer, sensitive_data)).

query iss: bitstring, sens_d: bitstring;
      event(app_client_tls(server_hostname, server_cert_subject_and_san, iss, sens_d)) ==>
      event(app_server_tls(server_hostname, server_cert_subject_and_san, iss, sens_d)).

query hostn: bitstring, subj_and_san: bitstring, iss: bitstring, sens_d: bitstring;
      event(app_client_tls(hostn, subj_and_san, iss, sens_d)) ==> event(app_server_tls(hostn, subj_and_san, iss, sens_d))
      .



process
  (!AppServer) | (!LegitimateApp)
