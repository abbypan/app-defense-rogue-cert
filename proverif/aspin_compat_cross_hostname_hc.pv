(* Generated by generate_compatible_models.py from aspin_cross_hostname_hc.pv. K_s is bound by an authenticated installed manifest.
 * Lifecycle checks are shared with the primary model; this file is
 * independently parsed and verified, including manifest provenance. *)

(* A new hostname has no historical H_k, while another hostname established
 * H_c for a shared signed Subject/SAN. Both hostnames use the SAME
 * current manifest K_s. A current-key-only T_k initializes the new hostname;
 * it must not reset the inherited H_c. Inputs remain on adversarial c. *)

free cross_hostname_origin: timestamp.
free cross_hostname_state: channel [private].
free cross_hostname_history: channel [private].
const multi_host_identity: bitstring.
const no_hostname_key_state: bitstring.

reduc cross_host_match(server_hostname, multi_host_identity) = true;
      cross_host_match(other_hostname, multi_host_identity) = true.
reduc forall t: timestamp; cross_host_max(t, t) = t;
      forall t1: timestamp; cross_host_max(t1, succ_t(t1)) = succ_t(t1);
      forall t2: timestamp; cross_host_max(succ_t(t2), t2) = succ_t(t2).

fun cross_host_key_entry(pkey, bitstring, timestamp): bitstring [private].
reduc forall key: pkey, host: bitstring, iat: timestamp;
      cross_host_read_key(cross_host_key_entry(key, host, iat), key, host) = iat.

event CrossHostOwnerAuthenticated(pkey, pkey).
event CrossHostClaimStateEstablished(pkey, bitstring, timestamp).
event HcOnlyKeyContextAbsent(pkey, bitstring).
event HcOnlyAccepted(pkey, bitstring, timestamp).
event HcOnlyKeyInitialized(pkey, bitstring, timestamp).
event HcOnlyTransferred(pkey, pkey, bitstring, timestamp, timestamp, timestamp).
event HcOnlyReplayRejected(pkey, bitstring, timestamp, timestamp).
event HcOnlyHostnameKeyLeak(bitstring, bitstring).
event HcOnlyBelowFloorCommit(timestamp, timestamp).

let CrossHostnamePublisher =
  let old_sk = gen_sk_for_id(self_host_signing) in
  let new_sk = gen_sk_for_id(self_host_signing) in
  let claim_sk = gen_sk_for_id(claim_signing) in
  let claim_key = pk(claim_sk) in
  let t0 = cross_hostname_origin in
  let t1 = succ_t(t0) in
  let t2 = succ_t(t1) in
  let exp = succ_t(t2) in
  let old_tk = jws_general_sign(pk2s(pk(old_sk)), pk2s(claim_key), t0, exp, old_sk) in
  let new_tk = jws_general_sign(pk2s(pk(new_sk)), pk2s(claim_key), t1, exp, new_sk) in
  event ClaimKeySign(old_sk, claim_key, t0, exp);
  event ClaimKeySign(new_sk, claim_key, t1, exp);
  out(c, old_tk); out(c, new_tk);
  let content = cert_claim(multi_host_identity, real_cert_issuer) in
  let tc0 = jws_general_sign(pk2s(claim_key), content, t0, exp, claim_sk) in
  let tc1 = jws_general_sign(pk2s(claim_key), content, t1, exp, claim_sk) in
  let tc2 = jws_general_sign(pk2s(claim_key), content, t2, exp, claim_sk) in
  event CertClaimSign(claim_sk, multi_host_identity, real_cert_issuer, t0, exp);
  event CertClaimSign(claim_sk, multi_host_identity, real_cert_issuer, t1, exp);
  event CertClaimSign(claim_sk, multi_host_identity, real_cert_issuer, t2, exp);
  out(c, tc0); out(c, tc1); out(c, tc2).

let TrustedCrossHostOwner =
  let old_root = pk(gen_sk_for_id(self_host_signing)) in
  let new_root = pk(gen_sk_for_id(self_host_signing)) in
  let apk_signer = pk(gen_sk_for_id(app_signing)) in
  let apk_manifest = app_manifest(target_app_id, new_root, installed_app_version) in
  event AppManifestSigned(target_app_id, apk_signer, new_root, installed_app_version);
  let apk_signature = sig_sign(apk_manifest, gen_sk_for_id(app_signing)) in
  let (=true) = sig_verify(apk_manifest, apk_signature, apk_signer) in
  event AppManifestAuthenticated(target_app_id, apk_signer, new_root, installed_app_version);
  event ManifestKeyBind(target_app_id, new_root);
  event CrossHostOwnerAuthenticated(old_root, new_root);
  out(cross_hostname_history, (old_root, new_root)).

let CrossHostnameSeed =
  let apk_signer = pk(gen_sk_for_id(app_signing)) in
  let apk_manifest = app_manifest(target_app_id, pk(gen_sk_for_id(self_host_signing)), installed_app_version) in
  event AppManifestSigned(target_app_id, apk_signer, pk(gen_sk_for_id(self_host_signing)), installed_app_version);
  let apk_signature = sig_sign(apk_manifest, gen_sk_for_id(app_signing)) in
  let (=true) = sig_verify(apk_manifest, apk_signature, apk_signer) in
  event AppManifestAuthenticated(target_app_id, apk_signer, pk(gen_sk_for_id(self_host_signing)), installed_app_version);
  event ManifestKeyBind(target_app_id, pk(gen_sk_for_id(self_host_signing)));
  let record = manifest_key_record(
      target_app_id, pk(gen_sk_for_id(self_host_signing))) in
  let root = resolve_manifest_key(record, target_app_id) in
  event ManifestKeyResolve(target_app_id, root);
  let now = succ_t(cross_hostname_origin) in
  in(c, tk: bitstring);
  let jws_general(hk: bitstring, payload_k: bitstring, sigk: bitstring) = tk in
  let (=true) = header_matches(hk, root) in
  let (=true) = jws_general_verify(tk, root) in
  let kiat = get_iat(payload_k) in
  let kexp = get_exp(payload_k) in
  let (=cross_hostname_origin) = kiat in
  let (=true) = token_fresh(kiat, kexp, now) in
  let delegated = s2pk(get_content(payload_k)) in
  event ClaimKeyVerify(root, delegated, kiat, kexp);
  in(c, tc: bitstring);
  let jws_general(hc: bitstring, payload_c: bitstring, sigc: bitstring) = tc in
  let (=true) = header_matches(hc, delegated) in
  let (=true) = jws_general_verify(tc, delegated) in
  let ciat = get_iat(payload_c) in
  let cexp = get_exp(payload_c) in
  let (=now) = ciat in
  let (=true) = token_fresh(ciat, cexp, now) in
  let content = get_content(payload_c) in
  let identity = get_subject_and_san(content) in
  let (=multi_host_identity) = identity in
  let (=true) = cross_host_match(server_hostname, identity) in
  let (=real_cert_issuer) = get_issuer(content) in
  event CertClaimVerify(delegated, identity, real_cert_issuer, ciat, cexp);
  event CrossHostClaimStateEstablished(root, identity, ciat);
  let old_entry = cross_host_key_entry(root, server_hostname, kiat) in
  (* The state snapshot has H_k for A only; B is explicitly uninitialized. *)
  out(cross_hostname_state,
      (root, old_entry, identity, ciat, no_hostname_key_state)).

let CrossHostnameVerifier =
  in(cross_hostname_history, (old_root: pkey, new_root: pkey));
  in(cross_hostname_state,
      (=old_root, old_entry: bitstring, identity: bitstring,
       inherited_c: timestamp, =no_hostname_key_state));
  event HcOnlyKeyContextAbsent(new_root, other_hostname);
  let now = succ_t(succ_t(cross_hostname_origin)) in
  in(c, tk: bitstring);
  let jws_general(hk: bitstring, payload_k: bitstring, sigk: bitstring) = tk in
  let (=true) = header_matches(hk, new_root) in
  let (=true) = jws_general_verify(tk, new_root) in
  let kiat = get_iat(payload_k) in
  let kexp = get_exp(payload_k) in
  let (=true) = token_fresh(kiat, kexp, now) in
  let delegated = s2pk(get_content(payload_k)) in
  event ClaimKeyVerify(new_root, delegated, kiat, kexp);
  in(c, tc: bitstring);
  let jws_general(hc: bitstring, payload_c: bitstring, sigc: bitstring) = tc in
  let (=true) = header_matches(hc, delegated) in
  let (=true) = jws_general_verify(tc, delegated) in
  let ciat = get_iat(payload_c) in
  let cexp = get_exp(payload_c) in
  let content = get_content(payload_c) in
  let (=identity) = get_subject_and_san(content) in
  let (=true) = cross_host_match(other_hostname, identity) in
  let (=real_cert_issuer) = get_issuer(content) in
  let (=true) = token_fresh(ciat, cexp, now) in
  event CertClaimVerify(delegated, identity, real_cert_issuer, ciat, cexp);
  let (=true) = iat_not_older(ciat, inherited_c) in
  (
    let merged_c = cross_host_max(inherited_c, ciat) in
    (* Both tokens passed before either protected state update is committed. *)
    event HcOnlyKeyInitialized(new_root, other_hostname, kiat);
    event HcOnlyTransferred(old_root, new_root, other_hostname,
        inherited_c, ciat, merged_c);
    event HcOnlyAccepted(new_root, other_hostname, ciat);
    let new_entry = cross_host_key_entry(new_root, other_hostname, kiat) in
    let (=kiat) = cross_host_read_key(new_entry, new_root, other_hostname) in
    (
      let (=true) = iat_older(merged_c, inherited_c) in
      event HcOnlyBelowFloorCommit(merged_c, inherited_c)
    ) |
    (
      let leaked = cross_host_read_key(old_entry, old_root, other_hostname) in
      event HcOnlyHostnameKeyLeak(server_hostname, other_hostname)
    )
  )
  else
    let (=true) = iat_older(ciat, inherited_c) in
    event HcOnlyReplayRejected(new_root, other_hostname, ciat, inherited_c).

query old_root: pkey, new_root: pkey, host: bitstring,
      floor: timestamp, accepted: timestamp, merged: timestamp;
  event(HcOnlyTransferred(old_root, new_root, host, floor, accepted, merged)) ==>
  event(CrossHostOwnerAuthenticated(old_root, new_root)).
query old_root: pkey, new_root: pkey, host: bitstring,
      floor: timestamp, accepted: timestamp, merged: timestamp;
  event(HcOnlyTransferred(old_root, new_root, host, floor, accepted, merged)) ==>
  event(CrossHostClaimStateEstablished(old_root, multi_host_identity, floor)).
query root: pkey, host: bitstring, iat: timestamp;
  event(HcOnlyKeyInitialized(root, host, iat)) ==>
  event(HcOnlyKeyContextAbsent(root, host)).
query root_sk: skey, delegated: pkey, iat: timestamp, exp: timestamp;
  event(ClaimKeyVerify(pk(root_sk), delegated, iat, exp)) ==>
  event(ClaimKeySign(root_sk, delegated, iat, exp)).
query claim_sk: skey, identity: bitstring, issuer: bitstring,
      iat: timestamp, exp: timestamp;
  event(CertClaimVerify(pk(claim_sk), identity, issuer, iat, exp)) ==>
  event(CertClaimSign(claim_sk, identity, issuer, iat, exp)).
query root: pkey;
  event(HcOnlyAccepted(root, other_hostname, succ_t(cross_hostname_origin))).
query root: pkey;
  event(HcOnlyAccepted(root, other_hostname, succ_t(succ_t(cross_hostname_origin)))).
query root: pkey;
  event(HcOnlyReplayRejected(root, other_hostname, cross_hostname_origin,
      succ_t(cross_hostname_origin))).
query root: pkey;
  event(HcOnlyAccepted(root, other_hostname, cross_hostname_origin)).
query low: timestamp, high: timestamp;
  event(HcOnlyBelowFloorCommit(low, high)).
query first: bitstring, second: bitstring;
  event(HcOnlyHostnameKeyLeak(first, second)).

query app: bitstring, root: pkey;
  event(ManifestKeyResolve(app, root)) ==> event(ManifestKeyBind(app, root)).
query app: bitstring, root: pkey, signer: pkey, version: bitstring;
  event(ManifestKeyBind(app, root)) ==>
  event(AppManifestAuthenticated(app, signer, root, version)).
query app: bitstring, root: pkey, signer: pkey, version: bitstring;
  event(AppManifestAuthenticated(app, signer, root, version)) ==>
  event(AppManifestSigned(app, signer, root, version)).
query old_root: pkey, new_root: pkey, host: bitstring,
      floor: timestamp, accepted: timestamp, merged: timestamp,
      signer: pkey, version: bitstring;
  event(HcOnlyTransferred(old_root, new_root, host, floor, accepted, merged)) ==>
  event(AppManifestAuthenticated(target_app_id, signer, new_root, version)).

process
  CrossHostnamePublisher | TrustedCrossHostOwner |
  CrossHostnameSeed | CrossHostnameVerifier
