(*
 * App-signing-key rotation using General JWS JSON Serialization.
 * T'_k contains old-key and new-key signatures over one identical payload.
 * T''_k is later, new-key-only, and the protected highest-seen iat survives
 * the app update.  The old T_k remains fresh in the replay trace so rollback,
 * rather than expiration, is the decisive rejection condition.
 *)

free rotation_time_0: timestamp.
const rotation_old_form: bitstring.
const rotation_dual_form: bitstring.
const rotation_new_form: bitstring.
free rotation_old_delivery: channel [private].
free rotation_new_delivery: channel [private].

event KeyTokenPublished(
    bitstring, pkey, pkey, timestamp, timestamp).
event KeyRotationOldAppVerified(
    pkey, pkey, timestamp, timestamp).
event KeyRotationNewAppVerified(
    pkey, pkey, timestamp, timestamp).
event KeyRotationCutoverVerified(
    pkey, pkey, timestamp, timestamp).
event KeyRotationOldReplayRejected(
    pkey, timestamp, timestamp).
event OldOnlyTokenAcceptedByNewKey(pkey, pkey).

let RotationServer =
  let sk_old = gen_sk_for_id(app_signing) in
  let sk_new = gen_sk_for_id(other_app_signing) in
  let sk_claim = gen_sk_for_id(claim_signing) in
  let pk_old = pk(sk_old) in
  let pk_new = pk(sk_new) in
  let claim_key = pk(sk_claim) in
  let content = pk2s(claim_key) in
  let iat0 = rotation_time_0 in
  let iat1 = succ_t(iat0) in
  let iat2 = succ_t(iat1) in

  (* Initial old-key token has a long enough signed window to remain fresh at
   * the modeled replay attempt after cutover. *)
  let exp0 = succ_t(succ_t(succ_t(iat0))) in
  let token0 = jwt_sign(
      pk2s(pk_old), content, iat0, exp0, sk_old) in
  event ClaimKeySign(sk_old, claim_key, iat0, exp0);
  event KeyTokenPublished(
      rotation_old_form, pk_old, claim_key, iat0, exp0);

  (* T'_k: two signatures, two protected kid values, one common payload. *)
  let exp1 = succ_t(succ_t(iat1)) in
  let token1 = jws_dual_sign(
      pk2s(pk_old), pk2s(pk_new), content, iat1, exp1, sk_old, sk_new) in
  event ClaimKeySign(sk_old, claim_key, iat1, exp1);
  event ClaimKeySign(sk_new, claim_key, iat1, exp1);
  event KeyTokenPublished(
      rotation_dual_form, pk_old, claim_key, iat1, exp1);
  event KeyTokenPublished(
      rotation_dual_form, pk_new, claim_key, iat1, exp1);

  (* T''_k: strictly later iat and only the new app-key signature. *)
  let exp2 = succ_t(succ_t(iat2)) in
  let token2 = jwt_sign(
      pk2s(pk_new), content, iat2, exp2, sk_new) in
  event ClaimKeySign(sk_new, claim_key, iat2, exp2);
  event KeyTokenPublished(
      rotation_new_form, pk_new, claim_key, iat2, exp2);

  (* Public copies model untrusted HTTP distribution. *)
  out(c, token0);
  out(c, token1);
  out(c, token2);
  (* Private scheduler copies select successful old/new app update traces. *)
  out(rotation_old_delivery, (pk_old, pk_new, token0, token1));
  out(rotation_new_delivery, (pk_old, pk_new, token0, token1, token2))
  .

let OldApp =
  in(rotation_old_delivery,
     (pk_old: pkey, pk_new: pkey, token0: bitstring, token1: bitstring));

  let jwt(h0: bitstring, p0: bitstring, s0: bitstring) = token0 in
  let (=true) = header_matches(h0, pk_old) in
  let (=true) = jwt_sig_verify(token0, pk_old) in
  let iat0 = get_iat(p0) in
  let exp0 = get_exp(p0) in
  let (=true) = token_fresh(iat0, exp0, rotation_time_0) in
  let (=ttl_three) = derive_ttl(iat0, exp0) in
  let claim_key0 = s2pk(get_content(p0)) in
  event KeyRotationOldAppVerified(
      pk_old, claim_key0, iat0, exp0);

  let jws_dual(
      h_old: bitstring, h_new: bitstring, p1: bitstring,
      sig_old: bitstring, sig_new: bitstring) = token1 in
  let (=true) = header_matches(h_old, pk_old) in
  let (=true) = jws_dual_verify1(token1, pk_old) in
  let iat1 = get_iat(p1) in
  let exp1 = get_exp(p1) in
  let (=true) = token_fresh(iat1, exp1, iat1) in
  let (=true) = iat_not_older(iat1, iat0) in
  let claim_key1 = s2pk(get_content(p1)) in
  event KeyRotationOldAppVerified(
      pk_old, claim_key1, iat1, exp1);
  event DualSigAppKeyVerify(
      pk_old, pk_new, claim_key1, iat1, exp1)
  .

let UpdatedApp =
  in(rotation_new_delivery,
     (pk_old: pkey, pk_new: pkey, token0: bitstring,
      token1: bitstring, token2: bitstring));

  (* The updated app selects the new-key signature entry of T'_k. *)
  let jws_dual(
      h_old: bitstring, h_new: bitstring, p1: bitstring,
      sig_old: bitstring, sig_new: bitstring) = token1 in
  let (=true) = header_matches(h_new, pk_new) in
  let (=true) = jws_dual_verify2(token1, pk_new) in
  let iat1 = get_iat(p1) in
  let exp1 = get_exp(p1) in
  let (=true) = token_fresh(iat1, exp1, iat1) in
  let claim_key1 = s2pk(get_content(p1)) in
  event KeyRotationNewAppVerified(
      pk_new, claim_key1, iat1, exp1);

  (* The new-key-only T''_k advances highest-seen state. *)
  let jwt(h2: bitstring, p2: bitstring, s2: bitstring) = token2 in
  let (=true) = header_matches(h2, pk_new) in
  let (=true) = jwt_sig_verify(token2, pk_new) in
  let iat2 = get_iat(p2) in
  let exp2 = get_exp(p2) in
  let (=true) = token_fresh(iat2, exp2, iat2) in
  let (=true) = iat_not_older(iat2, iat1) in
  let claim_key2 = s2pk(get_content(p2)) in
  event KeyRotationCutoverVerified(
      pk_new, claim_key2, iat2, exp2);

  (* Replay old T_k: it is authentic under old key and still fresh, but its iat
   * is below the protected value carried across the app update. *)
  let jwt(h0: bitstring, p0: bitstring, s0: bitstring) = token0 in
  let old_iat = get_iat(p0) in
  let old_exp = get_exp(p0) in
  let (=true) = jwt_sig_verify(token0, pk_old) in
  let (=true) = token_fresh(old_iat, old_exp, iat2) in
  let (=true) = iat_older(old_iat, iat2) in
  event KeyRotationOldReplayRejected(
      pk_new, old_iat, iat2)
  .

(* Structural audit: an old-only signature cannot verify with K_apub^new. *)
let OldOnlySignatureAudit =
  let sk_old = gen_sk_for_id(app_signing) in
  let pk_new = pk(gen_sk_for_id(other_app_signing)) in
  let iat = rotation_time_0 in
  let exp = succ_t(succ_t(succ_t(iat))) in
  let token = jwt_sign(
      pk2s(pk(sk_old)), pk2s(pk(gen_sk_for_id(claim_signing))),
      iat, exp, sk_old) in
  let (=true) = jwt_sig_verify(token, pk_new) in
  event OldOnlyTokenAcceptedByNewKey(pk(sk_old), pk_new)
  .

query old_key: pkey, new_key: pkey, claim_key: pkey,
      iat: timestamp, exp: timestamp;
  event(DualSigAppKeyVerify(
      old_key, new_key, claim_key, iat, exp)).
query new_key: pkey, claim_key: pkey, iat: timestamp, exp: timestamp;
  event(KeyRotationNewAppVerified(
      new_key, claim_key, iat, exp)).
query new_key: pkey, claim_key: pkey, iat: timestamp, exp: timestamp;
  event(KeyRotationCutoverVerified(
      new_key, claim_key, iat, exp)).
query new_key: pkey, old_iat: timestamp, highest_iat: timestamp;
  event(KeyRotationOldReplayRejected(
      new_key, old_iat, highest_iat)).
query old_key: pkey, new_key: pkey;
  event(OldOnlyTokenAcceptedByNewKey(old_key, new_key)).

(* Verification events are grounded in the corresponding published forms. *)
query new_key: pkey, claim_key: pkey, iat: timestamp, exp: timestamp;
  event(KeyRotationNewAppVerified(
      new_key, claim_key, iat, exp)) ==>
  event(KeyTokenPublished(
      rotation_dual_form, new_key, claim_key, iat, exp)).
query new_key: pkey, claim_key: pkey, iat: timestamp, exp: timestamp;
  event(KeyRotationCutoverVerified(
      new_key, claim_key, iat, exp)) ==>
  event(KeyTokenPublished(
      rotation_new_form, new_key, claim_key, iat, exp)).
query new_key: pkey, old_iat: timestamp, highest_iat: timestamp;
  event(KeyRotationOldReplayRejected(
      new_key, old_iat, highest_iat)) ==>
  event(KeyRotationCutoverVerified(
      new_key, pk(gen_sk_for_id(claim_signing)),
      highest_iat, succ_t(succ_t(highest_iat)))).

process
  RotationServer | OldApp | UpdatedApp | OldOnlySignatureAudit
