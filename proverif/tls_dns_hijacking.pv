let RealServer =
  in(c, client_hello(rand_c, pk_c));
  let c_hello = client_hello(rand_c, pk_c) in
  let sk_real_server_cert = gen_sk_for_id(real_server) in
  let sk_real_issuer = gen_sk_for_id(real_cert_issuer) in
  let real_s_cert_sig = sig_sign(cert_content(pk(sk_real_server_cert), server_cert_subject_and_san, real_cert_issuer), 
  sk_real_issuer) in
  let real_s_cert = gen_cert(pk(sk_real_server_cert),
  server_cert_subject_and_san,
  real_cert_issuer,
  real_s_cert_sig
   ) in

  new sk_real_server_temp: skey;
  new random_real_server: bitstring;
   let real_s_hello = server_hello(random_real_server, pk(sk_real_server_temp)) in
  let trans = transcript_hash(c_hello, real_s_hello, real_s_cert) in
  let s_handshake_sig = sig_sign(trans, sk_real_server_cert) in
  out(c, server_hello_handshake(server_hostname, server_ip, server_mechine, real_s_hello, real_s_cert, s_handshake_sig));

  let ss = session_key(server_shared_secret(sk_real_server_temp, pk_c), trans) in
 
  in(c, sens_cipher: bitstring);
  if check_authtag(ss, sens_cipher) = true
  then (
  event real_server_conn(server_hostname, trans, dec_data(ss, sens_cipher), real_s_cert, sens_cipher)
  )
  .

let DNSHijackingRogueServer =
  new sk_rogue_server_temp: skey;
  new random_rogue_server: bitstring;
  in(c, client_hello(rand_c, pk_c));
  let sk_rogue_server_cert = gen_sk_for_id(rogue_server) in
   let sk_rogue_issuer = gen_sk_for_id(rogue_cert_issuer) in
  let rogue_s_cert_sig = sig_sign(cert_content(pk(sk_rogue_server_cert), server_cert_subject_and_san, rogue_cert_issuer), 
  sk_rogue_issuer) in
  let rogue_s_cert =   gen_cert(pk(sk_rogue_server_cert), server_cert_subject_and_san, rogue_cert_issuer, rogue_s_cert_sig) in
  let rogue_s_hello = server_hello(random_rogue_server, pk(sk_rogue_server_temp)) in
  let rogue_trans = transcript_hash(client_hello(rand_c, pk_c), rogue_s_hello, rogue_s_cert) in
  let rogue_s_handshake_sig = sig_sign(rogue_trans, sk_rogue_server_cert) in
  out(c, server_hello_handshake(server_hostname, rogue_ip, rogue_mechine, rogue_s_hello, rogue_s_cert, rogue_s_handshake_sig));
 let ss_rogue = session_key(server_shared_secret(sk_rogue_server_temp, pk_c), rogue_trans) in
  in(c, sens_cipher: bitstring);
  if check_authtag(ss_rogue, sens_cipher) = true
  then (
  let sens_d = dec_data(ss_rogue, sens_cipher) in
  event rogue_server_conn(server_hostname, rogue_trans, sens_d, rogue_s_cert, sens_cipher)
  )
  .

let LegitimateApp =
  new sk_app_temp: skey;
  new random_app: bitstring;
  new sensitive_data: bitstring;
  let c_hello = client_hello(random_app, pk(sk_app_temp)) in
  out(c, c_hello);
 
  in(c, 
  server_hello_handshake(hostn, sip, smech, server_hello(rand_s, pk_recv), 
  gen_cert(cert_pk_recv, subj_and_san_recv, iss, cert_sig_recv),
  s_handshake_sig)
  );
  let s_hello = server_hello(rand_s, pk_recv) in
  let s_cert = gen_cert(cert_pk_recv, subj_and_san_recv, iss, cert_sig_recv) in
  let trans = transcript_hash(client_hello(random_app, pk(sk_app_temp)), 
  server_hello(rand_s, pk_recv),
  s_cert)
   in

  
    

 if  (check_host(hostn, subj_and_san_recv) = host_true) &&
     (sig_verify(cert_content(cert_pk_recv, subj_and_san_recv, iss), cert_sig_recv, pk(gen_sk_for_id(iss))) = true) &&
     (check_issuer(iss, system_ca_list) = issuer_true) &&
     (sig_verify(trans, s_handshake_sig, cert_pk_recv) = true)
      then
    (
      let ss = session_key(client_shared_secret(sk_app_temp, pk_recv), trans) in

      event app_conn(hostn, trans, sensitive_data, s_cert, enc_data(ss, sensitive_data));
      out(c, enc_data(ss, sensitive_data))
    )
    else
      event app_reject(hostn, subj_and_san_recv, iss)
      .
(* Query introduction:
   Each query asks whether a security property is reachable or guaranteed.
   ProVerif returns:
   - True  = the stated property holds in all executions of this model.
   - False = ProVerif found a counterexample/attack trace. *)

(* Query: Real-server receive path reachability.
   True  = there exists a trace where RealServer accepts/decrypts client data for the modeled legitimate transcript.
   False = this modeled RealServer acceptance path is unreachable. *)
query  sens_d: bitstring, sens_cipher: bitstring, rc: bitstring, pkc: pkey, rs: bitstring, pks: pkey;
  event(real_server_conn(server_hostname,
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer))), sens_cipher)).

(* Query: Client acceptance path reachability.
   True  = there exists a trace where the app accepts the modeled legitimate transcript and sends ciphertext.
   False = this modeled app-acceptance path is unreachable. *)
query  sens_d: bitstring, sens_cipher: bitstring, rc: bitstring, pkc: pkey, rs: bitstring, pks: pkey;
  event(app_conn(server_hostname, 
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer))), sens_cipher)).

(* Query: Real-server implies app-accepted correspondence.
   True  = whenever RealServer accepts the modeled legitimate transcript, the app also accepted it.
   False = there is a trace where RealServer connects but app_conn does not occur. *)
query  sens_d: bitstring, sens_cipher: bitstring, rc: bitstring, pkc: pkey, rs: bitstring, pks: pkey;
  event(real_server_conn(server_hostname,
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer))), sens_cipher))
  ==>
  event(app_conn(server_hostname, 
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer))), sens_cipher))
  .

(* Query: Client-side rejection of rogue TLS session.
   True  = client can reject mismatched issuer/session.
   False = rejection event never occurs in this model. *)
query event(app_reject(server_hostname, server_cert_subject_and_san, rogue_cert_issuer)).

(* Query: Rogue-server acceptance reachability.
   True  = there exists a trace where the rogue server accepts/decrypts data under the modeled rogue transcript.
   False = rogue acceptance/decryption is unreachable in this model. *)
query  sens_d: bitstring, sens_cipher: bitstring, rc: bitstring, pkc: pkey, rs: bitstring, pks: pkey;
  event(rogue_server_conn(server_hostname,
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_cert_issuer))), sens_cipher)).


(* Query: Client acceptance path reachability.
   True  = there exists a trace where the app accepts the modeled rogue transcript and sends ciphertext.
   False = this modeled app-acceptance path is unreachable. *)
query  sens_d: bitstring, sens_cipher: bitstring, rc: bitstring, pkc: pkey, rs: bitstring, pks: pkey;
  event(app_conn(server_hostname, 
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_cert_issuer))), sens_cipher)).


(* Query: rogue-server implies app-accepted correspondence.
   True  = whenever rogueServer accepts the modeled rogue transcript, the app also accepted it.
   False = there is a trace where rogueServer connects but app_conn does not occur. *)
query  sens_d: bitstring, sens_cipher: bitstring, rc: bitstring, pkc: pkey, rs: bitstring, pks: pkey;
  event(rogue_server_conn(server_hostname,
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_cert_issuer))), sens_cipher))
  ==>
  event(app_conn(server_hostname, 
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_cert_issuer))), sens_cipher))
  .

process
  (!RealServer) | (!DNSHijackingRogueServer) | (!LegitimateApp) 
