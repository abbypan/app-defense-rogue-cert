set attacker = active.
(* set attacker = passive. *)

(* This model is intended to be checked together with base.pvl. *)



let RealServer =
  in(c, pk_c: pkey);
  out(c, server_hello(
      server_hostname, server_ip, server_mechine, server_cert_subject_and_san, server_cert_issuer, pk(sk_real_server_temp), pk(sk_real_server_cert)
  ));
  event real_server_sent(server_hostname, server_cert_subject_and_san, server_cert_issuer, pk(sk_real_server_temp));
  in(c, sens_cipher: bitstring);
  let ss = shared_secret(sk_real_server_temp, pk_c) in
  let sens_d = dec_data(ss, sens_cipher) in
  event real_server_recv(sens_d, pk_c).

(* DNS hijack adversary endpoint:
   after name resolution is poisoned, the client is redirected here.
   It serves a rogue certificate chain and attacker-controlled TLS payload. *)
let DNSHijackingRogueServer =
  in(c, pk_c: pkey);
  out(c, server_hello(
      server_hostname, rogue_ip, rogue_mechine, server_cert_subject_and_san, rogue_cert_issuer, pk(sk_rogue_server_temp), pk(sk_rogue_server_cert)
  ));
  event rogue_server_sent(server_hostname, server_cert_subject_and_san, rogue_cert_issuer, pk(sk_rogue_server_temp));
  in(c, sens_cipher: bitstring);
  let ss = shared_secret(sk_rogue_server_temp, pk_c) in
  let sens_d = dec_data(ss, sens_cipher) in
  event rogue_server_recv(sens_d).

let LegitimateApp =
  out(c, pk(sk_app_temp));
  in(c, server_hello(hostn, sip, smech, subj_and_san_recv, iss, pk_s, cert_pk_s));
  let ss = shared_secret(sk_app_temp, pk_s) in
  let sens_cipher = enc_data(ss, sensitive_data) in
  (* Vulnerability: no hostname/SAN match check, only CA/issuer check. *)
  if (check_host(hostn, subj_and_san_recv) = host_true) &&
     (check_issuer(iss, system_ca_list) = issuer_true) &&
     (check_cert_pk(iss, cert_pk_s) = cert_pk_true) &&
     (check_temp_pk(cert_pk_s, pk_s) = temp_pk_true)  
     then
    out(c, sens_cipher);
    event app_accepted(hostn, subj_and_san_recv, iss, sensitive_data, pk_s);
    if iss = rogue_cert_issuer then
      event app_tricked(hostn, subj_and_san_recv, iss, sensitive_data).

query attacker(sensitive_data).

query event(rogue_server_recv(sensitive_data)).



(* Query 1: Attack reachability.
   True  = the client can accept a rogue certificate path
           and send sensitive data to the rogue endpoint.
   False = this BGP-hijack rogue-cert path is not reachable. *)
query event(app_tricked(server_hostname, server_cert_subject_and_san, rogue_cert_issuer, sensitive_data)).

process
  (!RealServer) | (!DNSHijackingRogueServer) | (!LegitimateApp)
