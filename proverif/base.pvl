set traceDisplay = long.
set attacker = passive.


(* type *)
type skey [private].
type pkey.
type timestamp.
type ip.
type mechine.



(* free *)
const system_ca_list: bitstring.

const server_hostname: bitstring.
const server_cert_subject_and_san: bitstring.


const real_cert_issuer: bitstring.
const rogue_cert_issuer: bitstring.

const server_ip: ip.
const server_mechine: mechine.

const rogue_ip: ip.
const rogue_mechine: mechine.

free curr: timestamp.

(* app signing key *)
const app_signing: bitstring.
const claim_signing: bitstring.

const real_server: bitstring.
const rogue_server: bitstring.



(* channel *)
free c: channel.
free cc: channel.
free cs: channel.

fun pk(skey): pkey.

(* Asymmetric signature primitives *)
fun sig_sign(bitstring, skey): bitstring.
reduc forall m: bitstring, sk: skey;
      sig_verify(m, sig_sign(m, sk), pk(sk)) = true.

fun gen_sk_for_id(bitstring) : skey [private].
fun gen_cert(pkey, bitstring, bitstring, bitstring) : bitstring [data].
fun cert_content(pkey, bitstring, bitstring): bitstring [data]. 


reduc check_host(server_hostname, server_cert_subject_and_san) = true.

reduc check_issuer(real_cert_issuer, system_ca_list) = true;
check_issuer(rogue_cert_issuer, system_ca_list) = true.



fun client_shared_secret(skey, pkey): bitstring [private].
reduc forall csk: skey, ssk: skey;
      server_shared_secret(ssk, pk(csk)) = client_shared_secret(csk, pk(ssk)).

fun session_key(bitstring, bitstring): bitstring [private].


(* tls *)
fun enc_data(bitstring, bitstring) : bitstring.
reduc forall k: bitstring, d: bitstring;
      dec_data(k, enc_data(k, d)) = d.
reduc forall k: bitstring, d:bitstring;
      check_authtag(k, enc_data(k, d)) = true.

fun client_hello(bitstring, pkey) : bitstring [data].
fun server_hello(bitstring, pkey) : bitstring [data].
fun transcript_hash(bitstring, bitstring, bitstring): bitstring [data].

fun server_hello_handshake(bitstring, ip, mechine, bitstring, bitstring, bitstring) : bitstring [data].



(* pkey <-> bitstring *)
fun pk2s(pkey): bitstring.
reduc forall pkv: pkey;
      s2pk(pk2s(pkv)) = pkv.

(* Timestamp definitions *)
fun succ_t(timestamp): timestamp.
fun prev_t(timestamp): timestamp.

reduc forall t: timestamp;
      ts_geq(prev_t(t), t) = false;
      forall t2: timestamp;
      ts_geq(succ_t(t2), t2) = true;
      forall t3: timestamp;
      ts_geq(t3, t3) = true.


(* cert claim *)
fun cert_claim(bitstring, bitstring): bitstring [data]. (* subject_and_san, issuer *)

reduc forall subject_and_san: bitstring, issuer: bitstring;
      get_subject_and_san(cert_claim(subject_and_san,issuer)) = subject_and_san.
reduc forall subject_and_san: bitstring, issuer: bitstring;
      get_issuer(cert_claim(subject_and_san,issuer)) = issuer.




(* jwt *)
fun jwt_payload(bitstring, timestamp): bitstring [data]. (* content, exp *)
reduc forall content: bitstring, exp: timestamp;
      get_content(jwt_payload(content, exp)) = content.
reduc forall content: bitstring, exp: timestamp;
      get_exp(jwt_payload(content, exp)) = exp.

fun jwt(bitstring, bitstring, bitstring): bitstring [data].  (* header, payload, signature *)
fun jwt_tosign(bitstring, bitstring): bitstring.             (* header, payload *)

reduc forall header: bitstring, payload: bitstring, signature: bitstring;
      get_jwt_header(jwt(header, payload, signature)) = header.

reduc forall header: bitstring, payload: bitstring, signature: bitstring;
      get_jwt_payload(jwt(header, payload, signature)) = payload.

reduc forall header: bitstring, payload: bitstring, signature: bitstring;
      get_jwt_sig(jwt(header, payload, signature)) = signature.

reduc forall header: bitstring, content: bitstring, exp: timestamp, privkey: skey;
      jwt_sign(header, content, exp, privkey) =
      jwt(header,
          jwt_payload(content, exp),
          sig_sign(jwt_tosign(header, jwt_payload(content, exp)), privkey)).


(* jwt_verify checks: valid signature and token not expired *)
reduc forall content: bitstring, sk: skey, now: timestamp;
      jwt_verify(jwt(pk2s(pk(sk)),
                     jwt_payload(content, now),
                     sig_sign(jwt_tosign(pk2s(pk(sk)), jwt_payload(content, now)), sk)),
                 pk(sk), now) = true;
      forall content2: bitstring, sk2: skey, now2: timestamp;
      jwt_verify(jwt(pk2s(pk(sk2)),
                     jwt_payload(content2, succ_t(now2)),
                     sig_sign(jwt_tosign(pk2s(pk(sk2)), jwt_payload(content2, succ_t(now2))), sk2)),
                 pk(sk2), now2) = true.



event ClaimKeySign(skey, pkey, timestamp).
event ClaimKeyVerify(pkey, pkey, timestamp).
event CertClaimSign(skey, bitstring, bitstring, timestamp).
event CertClaimVerify(pkey, bitstring, bitstring, timestamp).


event RSConn(bitstring, bitstring, bitstring, bitstring, bitstring).
event MSConn(bitstring, bitstring, bitstring, bitstring, bitstring).

event AppConnRS(bitstring, bitstring, bitstring, bitstring, bitstring).
event AppConnMS(bitstring, bitstring, bitstring, bitstring, bitstring).

event AppRejectConn(bitstring, bitstring, bitstring).


event MSFakeServer(bitstring, bitstring, bitstring, bitstring, bitstring).
event MSFakeClient(bitstring, bitstring, bitstring, bitstring, bitstring).
