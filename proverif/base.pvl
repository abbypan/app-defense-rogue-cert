set traceDisplay = long.
set attacker = active.


(* type *)
type skey [private].
type pkey.
type timestamp.
type ttl.
type ip.
type mechine.



(* free *)
const system_ca_list: bitstring.

const server_hostname: bitstring.
const server_cert_subject_and_san: bitstring.


const real_cert_issuer: bitstring.
const rogue_cert_issuer: bitstring.

const server_ip: ip.
const server_mechine: mechine.

const rogue_ip: ip.
const rogue_mechine: mechine.

free curr: timestamp.
const ttl_one: ttl.
const ttl_two: ttl.

(* app signing key *)
const app_signing: bitstring.
const claim_signing: bitstring.

const real_server: bitstring.
const rogue_server: bitstring.



(* channel *)
free c: channel.
free cc: channel.
free cs: channel.

fun pk(skey): pkey.

(* Asymmetric signature primitives *)
fun sig_sign(bitstring, skey): bitstring.
reduc forall m: bitstring, sk: skey;
      sig_verify(m, sig_sign(m, sk), pk(sk)) = true.

fun gen_sk_for_id(bitstring) : skey [private].
fun gen_cert(pkey, bitstring, bitstring, bitstring) : bitstring [data].
fun cert_content(pkey, bitstring, bitstring): bitstring [data]. 


reduc check_host(server_hostname, server_cert_subject_and_san) = true.

reduc check_issuer(real_cert_issuer, system_ca_list) = true;
check_issuer(rogue_cert_issuer, system_ca_list) = true.



fun client_shared_secret(skey, pkey): bitstring [private].
reduc forall csk: skey, ssk: skey;
      server_shared_secret(ssk, pk(csk)) = client_shared_secret(csk, pk(ssk)).

fun session_key(bitstring, bitstring): bitstring [private].


(* tls *)
fun enc_data(bitstring, bitstring) : bitstring.
reduc forall k: bitstring, d: bitstring;
      dec_data(k, enc_data(k, d)) = d.
reduc forall k: bitstring, d:bitstring;
      check_authtag(k, enc_data(k, d)) = true.

fun client_hello(bitstring, pkey) : bitstring [data].
fun server_hello(bitstring, pkey) : bitstring [data].
fun transcript_hash(bitstring, bitstring, bitstring): bitstring [data].

fun server_hello_handshake(bitstring, ip, mechine, bitstring, bitstring, bitstring) : bitstring [data].



(* pkey <-> bitstring *)
fun pk2s(pkey): bitstring.
reduc forall pkv: pkey;
      s2pk(pk2s(pkv)) = pkv.

(* Timestamp definitions *)
fun succ_t(timestamp): timestamp.
fun prev_t(timestamp): timestamp.

reduc forall t: timestamp;
      ts_geq(prev_t(t), t) = false;
      forall t2: timestamp;
      ts_geq(succ_t(t2), t2) = true;
      forall t3: timestamp;
      ts_geq(t3, t3) = true.


(* cert claim *)
fun cert_claim(bitstring, bitstring): bitstring [data]. (* subject_and_san, issuer *)

reduc forall subject_and_san: bitstring, issuer: bitstring;
      get_subject_and_san(cert_claim(subject_and_san,issuer)) = subject_and_san.
reduc forall subject_and_san: bitstring, issuer: bitstring;
      get_issuer(cert_claim(subject_and_san,issuer)) = issuer.




(* jwt *)
fun jwt_payload(bitstring, timestamp, ttl): bitstring [data]. (* content, exp, ttl *)
reduc forall content: bitstring, exp: timestamp, lifetime: ttl;
      get_content(jwt_payload(content, exp, lifetime)) = content.
reduc forall content: bitstring, exp: timestamp, lifetime: ttl;
      get_exp(jwt_payload(content, exp, lifetime)) = exp.
reduc forall content: bitstring, exp: timestamp, lifetime: ttl;
      get_ttl(jwt_payload(content, exp, lifetime)) = lifetime.

fun jwt(bitstring, bitstring, bitstring): bitstring [data].  (* header, payload, signature *)
fun jwt_tosign(bitstring, bitstring): bitstring.             (* header, payload *)

reduc forall header: bitstring, payload: bitstring, signature: bitstring;
      get_jwt_header(jwt(header, payload, signature)) = header.

reduc forall header: bitstring, payload: bitstring, signature: bitstring;
      get_jwt_payload(jwt(header, payload, signature)) = payload.

reduc forall header: bitstring, payload: bitstring, signature: bitstring;
      get_jwt_sig(jwt(header, payload, signature)) = signature.

reduc forall header: bitstring, content: bitstring, exp: timestamp,
             lifetime: ttl, privkey: skey;
      jwt_sign(header, content, exp, lifetime, privkey) =
      jwt(header,
          jwt_payload(content, exp, lifetime),
          sig_sign(jwt_tosign(header, jwt_payload(content, exp, lifetime)), privkey)).


(* jwt_verify checks: valid signature and token not expired *)
reduc forall content: bitstring, lifetime: ttl, sk: skey, now: timestamp;
      jwt_verify(jwt(pk2s(pk(sk)),
                     jwt_payload(content, now, lifetime),
                     sig_sign(jwt_tosign(pk2s(pk(sk)), jwt_payload(content, now, lifetime)), sk)),
                 pk(sk), now) = true;
      forall content2: bitstring, lifetime2: ttl, sk2: skey, now2: timestamp;
      jwt_verify(jwt(pk2s(pk(sk2)),
                     jwt_payload(content2, succ_t(now2), lifetime2),
                     sig_sign(jwt_tosign(pk2s(pk(sk2)), jwt_payload(content2, succ_t(now2), lifetime2)), sk2)),
                 pk(sk2), now2) = true.


(* General JWS Dual Signature for T_k app-signing key rotation *)
fun jws_dual(bitstring, bitstring, bitstring, bitstring, bitstring): bitstring [data].
reduc forall h1: bitstring, h2: bitstring, content: bitstring, exp: timestamp, lifetime: ttl, sk1: skey, sk2: skey;
      jws_dual_sign(h1, h2, content, exp, lifetime, sk1, sk2) =
      jws_dual(h1, h2, jwt_payload(content, exp, lifetime),
               sig_sign(jwt_tosign(h1, jwt_payload(content, exp, lifetime)), sk1),
               sig_sign(jwt_tosign(h2, jwt_payload(content, exp, lifetime)), sk2)).

reduc forall h1: bitstring, h2: bitstring, content: bitstring, lifetime: ttl, sk1: skey, sk2: skey, now: timestamp;
      jws_dual_verify1(jws_dual(h1, h2, jwt_payload(content, now, lifetime),
                                sig_sign(jwt_tosign(h1, jwt_payload(content, now, lifetime)), sk1),
                                sig_sign(jwt_tosign(h2, jwt_payload(content, now, lifetime)), sk2)),
                       pk(sk1), now) = true;
      forall h1: bitstring, h2: bitstring, content: bitstring, lifetime: ttl, sk1: skey, sk2: skey, now: timestamp;
      jws_dual_verify1(jws_dual(h1, h2, jwt_payload(content, succ_t(now), lifetime),
                                sig_sign(jwt_tosign(h1, jwt_payload(content, succ_t(now), lifetime)), sk1),
                                sig_sign(jwt_tosign(h2, jwt_payload(content, succ_t(now), lifetime)), sk2)),
                       pk(sk1), now) = true.

reduc forall h1: bitstring, h2: bitstring, content: bitstring, lifetime: ttl, sk1: skey, sk2: skey, now: timestamp;
      jws_dual_verify2(jws_dual(h1, h2, jwt_payload(content, now, lifetime),
                                sig_sign(jwt_tosign(h1, jwt_payload(content, now, lifetime)), sk1),
                                sig_sign(jwt_tosign(h2, jwt_payload(content, now, lifetime)), sk2)),
                       pk(sk2), now) = true;
      forall h1: bitstring, h2: bitstring, content: bitstring, lifetime: ttl, sk1: skey, sk2: skey, now: timestamp;
      jws_dual_verify2(jws_dual(h1, h2, jwt_payload(content, succ_t(now), lifetime),
                                sig_sign(jwt_tosign(h1, jwt_payload(content, succ_t(now), lifetime)), sk1),
                                sig_sign(jwt_tosign(h2, jwt_payload(content, succ_t(now), lifetime)), sk2)),
                       pk(sk2), now) = true.

(* Token scope constants and reductions *)
const default_app_id: bitstring.
const other_app_id: bitstring.
const default_scope_host: bitstring.
const other_scope_host: bitstring.

reduc check_app_id(default_app_id, default_app_id) = true.
reduc check_scope_host(server_hostname, server_hostname) = true.


event ClaimKeySign(skey, pkey, timestamp).
event ClaimKeyVerify(pkey, pkey, timestamp).
event CertClaimSign(skey, bitstring, bitstring, timestamp).
event CertClaimVerify(pkey, bitstring, bitstring, timestamp).


event RSAccept(bitstring, bitstring, bitstring, bitstring, bitstring).
event MSAccept(bitstring, bitstring, bitstring, bitstring, bitstring).

event AppConnRS(bitstring, bitstring, bitstring, bitstring, bitstring).
event AppConnMS(bitstring, bitstring, bitstring, bitstring, bitstring).

event AppReject(bitstring, bitstring, bitstring).


event MSConnRS(bitstring, bitstring, bitstring, bitstring, bitstring).

(* Additional events for expanded formal verification *)
event TokenScopeVerify(bitstring, bitstring).
event TokenScopeMismatch(bitstring, bitstring).
event RollbackRejected(bitstring, timestamp, timestamp).
event ExpiredTokenRejected(bitstring, timestamp, timestamp).
event EmergencyTokenRevoked(bitstring, timestamp).
event DualSigAppKeyVerify(pkey, pkey, pkey, timestamp).

