set traceDisplay = long.


(* type *)
type skey [private].
type pkey.
type timestamp.
type ip.
type mechine.



(* const *)
const system_ca_list: bitstring.

const server_hostname: bitstring.
const server_cert_subject_and_san: bitstring.


const server_cert_issuer: bitstring.
const rogue_cert_issuer: bitstring.

const server_ip: ip.
const server_mechine: mechine.

const rogue_ip: ip.
const rogue_mechine: mechine.

const sensitive_data: bitstring [private].

const curr: timestamp.

(* app signing key *)
free sk_app_signing: skey [private].
free sk_claim_signing: skey [private].

const sk_real_server_cert: skey [private].
const sk_real_server_temp: skey [private].
const sk_rogue_server_cert: skey [private].
const sk_rogue_server_temp: skey [private].
const sk_app_temp: skey [private].



(* channel *)
free c: channel.

fun pk(skey): pkey.

const temp_pk_true: bitstring.
const temp_pk_false: bitstring.
reduc 
      check_temp_pk(pk(sk_real_server_cert), pk(sk_real_server_temp)) = temp_pk_true;
     check_temp_pk(pk(sk_rogue_server_cert), pk(sk_rogue_server_temp)) = temp_pk_true;
      check_temp_pk(pk(sk_real_server_cert), pk(sk_rogue_server_temp)) = temp_pk_false;
      check_temp_pk(pk(sk_rogue_server_cert), pk(sk_real_server_temp)) = temp_pk_false.


const cert_pk_true: bitstring.
const cert_pk_false: bitstring.
reduc 
      check_cert_pk(server_cert_issuer, pk(sk_real_server_cert)) = cert_pk_true;
     check_cert_pk(rogue_cert_issuer, pk(sk_rogue_server_cert)) = cert_pk_true;
      check_cert_pk(server_cert_issuer, pk(sk_rogue_server_cert)) = cert_pk_false;
      check_cert_pk(rogue_cert_issuer, pk(sk_real_server_cert)) = cert_pk_false.



fun shared_secret(skey,pkey): bitstring [private].
equation forall sk: skey, peer_sk: skey;
    shared_secret(sk, pk(peer_sk)) = shared_secret(peer_sk, pk(sk)).

(* tls *)
fun enc_data(bitstring, bitstring) : bitstring.
reduc forall k: bitstring, d: bitstring;
      dec_data(k, enc_data(k, d)) = d.
      
fun server_hello(bitstring, ip, mechine, bitstring, bitstring, pkey, pkey) : bitstring [data].


const host_true: bitstring.
reduc check_host(server_hostname, server_cert_subject_and_san) = host_true.

const issuer_true: bitstring.
reduc
  check_issuer(server_cert_issuer, system_ca_list) = issuer_true;
  check_issuer(rogue_cert_issuer, system_ca_list) = issuer_true
  .

(* Preserve issuer equality helper in token style. *)
const same_issuer_true: bitstring.
const same_issuer_false: bitstring.
reduc forall iss: bitstring;
      is_same_issuer(iss, iss) = same_issuer_true;
      is_same_issuer(server_cert_issuer, rogue_cert_issuer) = same_issuer_false;
      is_same_issuer(rogue_cert_issuer, server_cert_issuer) = same_issuer_false.


(* Preserve ip equality helper in token style. *)
const same_ip_true: bitstring.
const same_ip_false: bitstring.
reduc forall ipx: ip;
      is_same_ip(ipx, ipx) = same_ip_true;
      is_same_ip(server_ip, rogue_ip) = same_ip_false;
      is_same_ip(rogue_ip, server_ip) = same_ip_false.


(* Preserve mechine equality helper in token style. *)
const same_mechine_true: bitstring.
const same_mechine_false: bitstring.
reduc forall mechx: mechine;
      is_same_mechine(mechx, mechx) = same_mechine_true;
      is_same_mechine(server_mechine, rogue_mechine) = same_mechine_false;
      is_same_mechine(rogue_mechine, server_mechine) = same_mechine_false.


(* Asymmetric signature primitives *)
fun sig_sign(bitstring, skey): bitstring.
reduc forall m: bitstring, sk: skey;
      sig_verify(m, sig_sign(m, sk), pk(sk)) = true.

(* pkey <-> bitstring *)
fun pk2s(pkey): bitstring.
reduc forall pkv: pkey;
      s2pk(pk2s(pkv)) = pkv.

(* Timestamp definitions *)
fun succ_t(timestamp): timestamp.
fun prev_t(timestamp): timestamp.

reduc forall t: timestamp;
      ts_geq(prev_t(t), t) = false;
      forall t2: timestamp;
      ts_geq(succ_t(t2), t2) = true;
      forall t3: timestamp;
      ts_geq(t3, t3) = true.


(* cert claim *)
fun cert_claim(bitstring, bitstring): bitstring [data]. (* subject_and_san, issuer *)
reduc forall subject_and_san: bitstring, issuer: bitstring;
      get_subject_and_san(cert_claim(subject_and_san,issuer)) = subject_and_san.
reduc forall subject_and_san: bitstring, issuer: bitstring;
      get_issuer(cert_claim(subject_and_san,issuer)) = issuer.


(* cert *)
fun cert(bitstring, bitstring, pkey, bitstring): bitstring [data]. (* subject_and_sans, issuer, subject public key, signature *)
reduc forall subject_and_san: bitstring, issuer: bitstring, spk: pkey, sig: bitstring;
      get_cert_claim(cert(subject_and_san, issuer, spk, sig)) = cert_claim(subject_and_san, issuer).
reduc forall subject_and_san: bitstring, issuer: bitstring, spk: pkey, sig: bitstring;
      get_cert_spk(cert(subject_and_san, issuer, spk, sig)) = spk.


(* jwt *)
fun jwt_payload(bitstring, timestamp): bitstring [data]. (* content, exp *)
reduc forall content: bitstring, exp: timestamp;
      get_content(jwt_payload(content, exp)) = content.
reduc forall content: bitstring, exp: timestamp;
      get_exp(jwt_payload(content, exp)) = exp.

fun jwt(bitstring, bitstring, bitstring): bitstring [data].  (* header, payload, signature *)
fun jwt_tosign(bitstring, bitstring): bitstring.             (* header, payload *)

reduc forall header: bitstring, payload: bitstring, signature: bitstring;
      get_jwt_header(jwt(header, payload, signature)) = header.

reduc forall header: bitstring, payload: bitstring, signature: bitstring;
      get_jwt_payload(jwt(header, payload, signature)) = payload.

reduc forall header: bitstring, payload: bitstring, signature: bitstring;
      get_jwt_sig(jwt(header, payload, signature)) = signature.

reduc forall header: bitstring, content: bitstring, exp: timestamp, privkey: skey;
      jwt_sign(header, content, exp, privkey) =
      jwt(header,
          jwt_payload(content, exp),
          sig_sign(jwt_tosign(header, jwt_payload(content, exp)), privkey)).


(* jwt_verify checks: valid signature and token not expired *)
reduc forall content: bitstring, sk: skey, now: timestamp;
      jwt_verify(jwt(pk2s(pk(sk)),
                     jwt_payload(content, now),
                     sig_sign(jwt_tosign(pk2s(pk(sk)), jwt_payload(content, now)), sk)),
                 pk(sk), now) = true;
      forall content2: bitstring, sk2: skey, now2: timestamp;
      jwt_verify(jwt(pk2s(pk(sk2)),
                     jwt_payload(content2, succ_t(now2)),
                     sig_sign(jwt_tosign(pk2s(pk(sk2)), jwt_payload(content2, succ_t(now2))), sk2)),
                 pk(sk2), now2) = true.



event jwt_claim_signing_key_create(pkey, pkey, timestamp).
event jwt_claim_signing_key_verify(pkey, pkey, timestamp).
event jwt_server_cert_claim_create(pkey, bitstring, bitstring, timestamp).
event jwt_server_cert_claim_verify(pkey, bitstring, bitstring, timestamp).

event real_server_sent(bitstring, bitstring, bitstring, pkey).
event real_server_recv(bitstring, pkey).

event rogue_server_sent(bitstring, bitstring, bitstring, pkey).
event rogue_server_recv(bitstring).

event app_accepted(bitstring, bitstring, bitstring, bitstring, pkey).
event app_tricked(bitstring, bitstring, bitstring, bitstring).
event app_terminated_rogue(bitstring, bitstring, bitstring).


event mitm_monitors_client(pkey).
event mitm_monitors_server(bitstring, bitstring, bitstring, pkey).
event mitm_replaced_response(bitstring, bitstring, bitstring, pkey).
event mitm_intercepted(bitstring, bitstring, bitstring, bitstring).