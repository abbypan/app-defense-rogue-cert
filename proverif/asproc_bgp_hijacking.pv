set attacker = passive.



(*
const g_hostname : bitstring.
const g_ip: ip.
const g_mechine: mechine.
const g_sbj_san: bitstring.
const g_issuer: bitstring.
const sk_g_cert: skey [private].
const sk_g_temp: skey [private].
event guest_server_sent(bitstring,  bitstring, bitstring).
event guest_server_recv(bitstring).

free d: channel.
let GuestServer =
  in(d, pk_d: pkey);
  out(d, server_hello(
   g_hostname, g_ip, g_mechine, g_sbj_san, g_issuer, 
   pk(sk_g_temp), pk(sk_g_cert)));
  event guest_server_sent(g_hostname,  g_sbj_san, g_issuer);
  in(d, sens_cipher: bitstring);
  let ss = shared_secret(sk_g_temp, pk_d) in
  let sens_d = dec_data(ss, sens_cipher) in
  event guest_server_recv(sens_d)
  .
*)


let RealServer =
  let header = pk2s(pk(sk_app_signing)) in
  let good_exp = succ_t(curr) in
  let content = pk2s(pk(sk_claim_signing)) in
  let token = jwt_sign(header, content, good_exp, sk_app_signing) in
  event jwt_claim_signing_key_create(pk(sk_app_signing), pk(sk_claim_signing), good_exp);
  out(c, token);

  let header2 = pk2s(pk(sk_claim_signing)) in
  let good_exp2 = succ_t(curr) in
  let content2 = cert_claim(server_cert_subject_and_san, server_cert_issuer) in
  let token2 = jwt_sign(header2, content2, good_exp2, sk_claim_signing) in
  event jwt_server_cert_claim_create(pk(sk_claim_signing), server_cert_subject_and_san, server_cert_issuer, good_exp2);
  out(c, token2);
  
  in(c, pk_c: pkey);
  out(c, server_hello(server_hostname, server_ip, server_mechine, server_cert_subject_and_san, server_cert_issuer, pk(sk_real_server_temp), pk(sk_real_server_cert)));
  event real_server_sent(server_hostname, server_cert_subject_and_san, server_cert_issuer, pk(sk_real_server_cert));

  in(c, sens_cipher: bitstring);
  let ss = shared_secret(sk_real_server_temp, pk_c) in
  let sens_d = dec_data(ss, sens_cipher) in
  event real_server_recv(sens_d, pk_c)
  .

let BGPHijackingRogueServer =
  in(c, pk_c: pkey);
  out(c, server_hello(server_hostname, server_ip, rogue_mechine, server_cert_subject_and_san, rogue_cert_issuer, pk(sk_rogue_server_temp), pk(sk_rogue_server_cert)));
  event rogue_server_sent(server_hostname, server_cert_subject_and_san, rogue_cert_issuer, pk(sk_rogue_server_temp));
  in(c, sens_cipher: bitstring);
  let ss = shared_secret(sk_rogue_server_temp, pk_c) in
  let sens_d = dec_data(ss, sens_cipher) in
  event rogue_server_recv(sens_d)
  .

let LegitimateApp =
  in(c, jwt(h: bitstring, plr: bitstring, sr: bitstring));
  let pk_app_signing = pk(sk_app_signing) in
  let content = get_content(plr) in
  let pk1_recv = s2pk(content) in
  let exp_recv = get_exp(plr) in
  if jwt_verify(jwt(h, plr, sr), pk_app_signing, curr) = true then
      event jwt_claim_signing_key_verify(pk(sk_app_signing), pk1_recv, exp_recv);
 
  in(c, jwt(h2: bitstring, plr2: bitstring, sr2: bitstring));
  let content2 = get_content(plr2) in
  let subject_and_san2 = get_subject_and_san(content2) in
  let issuer2 = get_issuer(content2) in
  let exp2 = get_exp(plr2) in
  if jwt_verify(jwt(h2, plr2, sr2), pk1_recv, curr) = true then
      event jwt_server_cert_claim_verify(pk1_recv, subject_and_san2, issuer2, exp2);
 
  out(c, pk(sk_app_temp));
 
  in(c, server_hello(hostn, sip, smech, subj_and_san_recv, iss, pk_recv, cert_pk_recv));
 
 
 if  (check_host(hostn, subj_and_san_recv) = host_true) &&
     (check_issuer(iss, system_ca_list) = issuer_true) &&
     (check_cert_pk(iss, cert_pk_recv) = cert_pk_true) &&
     (check_temp_pk(cert_pk_recv, pk_recv) = temp_pk_true)  &&
     (check_host(hostn, subject_and_san2) = host_true) &&
     (is_same_issuer(issuer2, iss) = same_issuer_true)
      then
    (
       let ss = shared_secret(sk_app_temp, pk_recv) in
  let sens_cipher = enc_data(ss, sensitive_data) in
      out(c, sens_cipher);
      event app_accepted(hostn, subj_and_san_recv, iss, sensitive_data, pk_recv);
       if iss = rogue_cert_issuer then
      event app_tricked(hostn, subj_and_san_recv, iss, sensitive_data)
    )
    else
      event app_terminated_rogue(hostn, subj_and_san_recv, iss)
      .

(* Query: JWT key-chain authenticity.
   True  = every verification event has a matching creation event by RealServer.
   False = some verified claim-signing key has no matching creation event. *)
query app_pk: pkey, claim_pk: pkey, exp: timestamp;
  event(jwt_claim_signing_key_verify(app_pk, claim_pk, exp)) ==> event(jwt_claim_signing_key_create(app_pk, claim_pk, exp)).

(* Query: JWT server-cert-claim authenticity.
   True  = every verified cert claim has a matching creation event.
   False = a cert claim can be verified without being legitimately created. *)
query claim_pk: pkey, subject_and_san: bitstring, issuer: bitstring, exp: timestamp;
  event(jwt_server_cert_claim_verify(claim_pk, subject_and_san, issuer, exp)) ==> event(jwt_server_cert_claim_create(claim_pk, subject_and_san, issuer, exp)).

(* Query: Secrecy of application payload.
   True  = attacker can derive sensitive_data (secrecy broken).
   False = attacker cannot derive sensitive_data (secrecy preserved). *)
query attacker(sensitive_data).



(* Query: Client-side rejection of rogue TLS session.
   True  = client can reject mismatched issuer/session.
   False = rejection event never occurs in this model. *)
query event(app_terminated_rogue(server_hostname, server_cert_subject_and_san, rogue_cert_issuer)).

(* Query: Rogue server decryption of sensitive data.
   True  = there exists an execution where the rogue server receives and decrypts the client's sensitive_data.
   False = the modeled BGP-hijack/rogue server cannot obtain sensitive_data. *)
query event(rogue_server_recv(sensitive_data)).

query event(real_server_recv(sensitive_data, pk(sk_app_temp))).

query event(app_accepted(server_hostname, server_cert_subject_and_san, server_cert_issuer, sensitive_data, pk(sk_real_server_temp))).

(* Query: Intended legitimate TLS acceptance.
   True  = there exists a trace where client accepts legitimate server issuer/payload.
   False = intended legitimate acceptance trace is unreachable. *)
query event(real_server_recv(sensitive_data, pk(sk_app_temp))) ==> event(app_accepted(server_hostname, server_cert_subject_and_san, server_cert_issuer, sensitive_data, pk(sk_real_server_temp))).

process
  (!RealServer) | (!BGPHijackingRogueServer) | (!LegitimateApp) 
