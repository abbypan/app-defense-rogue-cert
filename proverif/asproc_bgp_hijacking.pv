let RealServer =
  let sk_app_signing = gen_sk_for_id(app_signing) in
  let sk_claim_signing = gen_sk_for_id(claim_signing) in
  
 
  
  let header = pk2s(pk(sk_app_signing)) in
  let good_exp = succ_t(curr) in
  let content = pk2s(pk(sk_claim_signing)) in
  let token = jwt_sign(header, content, good_exp, sk_app_signing) in
  event jwt_claim_signing_key_create(pk(sk_app_signing), pk(sk_claim_signing), good_exp);
  out(c, token);

  let header2 = pk2s(pk(sk_claim_signing)) in
  let good_exp2 = succ_t(curr) in
  let content2 = cert_claim(server_cert_subject_and_san, server_cert_issuer) in
  let token2 = jwt_sign(header2, content2, good_exp2, sk_claim_signing) in
  event jwt_server_cert_claim_create(pk(sk_claim_signing), server_cert_subject_and_san, server_cert_issuer, good_exp2);
  out(c, token2);
  
  in(c, client_hello(rand_c, pk_c));

 new sk_real_server_temp: skey;
  new random_real_server: bitstring;
  let sk_real_server_cert = gen_sk_for_id(real_server) in
  let sk_real_issuer = gen_sk_for_id(server_cert_issuer) in
  let real_s_cert_sig = sig_sign(cert_content(pk(sk_real_server_cert), server_cert_subject_and_san, server_cert_issuer), 
  sk_real_issuer) in
  let real_s_cert = gen_cert(pk(sk_real_server_cert),
  server_cert_subject_and_san,
  server_cert_issuer,
  real_s_cert_sig
   ) in
  
  let real_s_hello = server_hello(random_real_server, pk(sk_real_server_temp)) in
  let trans = transcript_hash(client_hello(rand_c, pk_c), real_s_hello, real_s_cert) in
  let s_handshake_sig = sig_sign(trans, sk_real_server_cert) in
  event real_server_sent(server_hostname, server_cert_subject_and_san, server_cert_issuer, pk(sk_real_server_cert));
  out(c, server_hello_handshake(server_hostname, server_ip, server_mechine, real_s_hello, real_s_cert, s_handshake_sig));

  let ss = session_key(shared_secret(sk_real_server_temp, pk_c), client_hello(rand_c, pk_c), real_s_hello) in
 
  in(c, sens_cipher: bitstring);
  if check_authtag(ss, sens_cipher) = true
  then (
  event real_server_accepted(server_hostname, trans, dec_data(ss, sens_cipher), real_s_cert)
  )
  .

let BGPHijackingRogueServer =
  new sk_rogue_server_temp: skey;
  new random_rogue_server: bitstring;
  in(c, client_hello(rand_c, pk_c));
  let sk_rogue_server_cert = gen_sk_for_id(rogue_server) in
   let sk_rogue_issuer = gen_sk_for_id(rogue_cert_issuer) in
  let rogue_s_cert_sig = sig_sign(cert_content(pk(sk_rogue_server_cert), server_cert_subject_and_san, rogue_cert_issuer), 
  sk_rogue_issuer) in
  let rogue_s_cert =   gen_cert(pk(sk_rogue_server_cert), server_cert_subject_and_san, rogue_cert_issuer, rogue_s_cert_sig) in
  let rogue_s_hello = server_hello(random_rogue_server, pk(sk_rogue_server_temp)) in
  let rogue_trans = transcript_hash(client_hello(rand_c, pk_c), rogue_s_hello, rogue_s_cert) in
  let rogue_s_handshake_sig = sig_sign(rogue_trans, sk_rogue_server_cert) in
  event rogue_server_sent(server_hostname, server_cert_subject_and_san, rogue_cert_issuer, pk(sk_rogue_server_temp));
  out(c, server_hello_handshake(server_hostname, server_ip, rogue_mechine, rogue_s_hello, rogue_s_cert, rogue_s_handshake_sig));
 let ss_rogue = session_key(shared_secret(sk_rogue_server_temp, pk_c),
  client_hello(rand_c, pk_c), rogue_s_hello
  ) in
  in(c, sens_cipher: bitstring);
  if check_authtag(ss_rogue, sens_cipher) = true
  then (
  let sens_d = dec_data(ss_rogue, sens_cipher) in
  event rogue_server_accepted(server_hostname, rogue_trans, sens_d, rogue_s_cert);
  out(c, sens_d)
  )
  .

let LegitimateApp =
  new sk_app_temp: skey;
  new random_app: bitstring;
  new sensitive_data: bitstring;
  in(c, jwt(h: bitstring, plr: bitstring, sr: bitstring));
  let pk_app_signing = pk(gen_sk_for_id(app_signing)) in
  let content = get_content(plr) in
  let pk1_recv = s2pk(content) in
  let exp_recv = get_exp(plr) in
  if jwt_verify(jwt(h, plr, sr), pk_app_signing, curr) = true then
      event jwt_claim_signing_key_verify(pk_app_signing, pk1_recv, exp_recv);
 
  in(c, jwt(h2: bitstring, plr2: bitstring, sr2: bitstring));
  let content2 = get_content(plr2) in
  let subject_and_san2 = get_subject_and_san(content2) in
  let issuer2 = get_issuer(content2) in
  let exp2 = get_exp(plr2) in
  if jwt_verify(jwt(h2, plr2, sr2), pk1_recv, curr) = true then
      event jwt_server_cert_claim_verify(pk1_recv, subject_and_san2, issuer2, exp2);
  
  let c_hello = client_hello(random_app, pk(sk_app_temp)) in
  out(c, c_hello);
 
  in(c, 
  server_hello_handshake(hostn, sip, smech, server_hello(rand_s, pk_recv), 
  gen_cert(cert_pk_recv, subj_and_san_recv, iss, cert_sig_recv),
  s_handshake_sig)
  );
  let s_hello = server_hello(rand_s, pk_recv) in
  let s_cert = gen_cert(cert_pk_recv, subj_and_san_recv, iss, cert_sig_recv) in
  let trans = transcript_hash(client_hello(random_app, pk(sk_app_temp)), 
  server_hello(rand_s, pk_recv),
  s_cert)
   in

 if  (check_host(hostn, subj_and_san_recv) = host_true) &&
     (sig_verify(cert_content(cert_pk_recv, subj_and_san_recv, iss), cert_sig_recv, pk(gen_sk_for_id(iss))) = true) &&
     (check_issuer(iss, system_ca_list) = issuer_true) &&
     (sig_verify(trans, s_handshake_sig, cert_pk_recv) = true) &&
     (check_host(hostn, subject_and_san2) = host_true) &&
     (issuer2 = iss)
      then
    (
      let ss = session_key(shared_secret(sk_app_temp, pk_recv), c_hello, s_hello) in
    
      event app_accepted(hostn, trans, sensitive_data, s_cert);
      out(c, enc_data(ss, sensitive_data));
      if iss = rogue_cert_issuer then
      event app_tricked(hostn, subj_and_san_recv, iss, sensitive_data)
    )
    else
      event app_terminated_rogue(hostn, subj_and_san_recv, iss)
      .

(* Query: JWT key-chain authenticity.
   True  = every verification event has a matching creation event by RealServer.
   False = some verified claim-signing key has no matching creation event. *)
query app_pk: pkey, claim_pk: pkey, exp: timestamp;
  event(jwt_claim_signing_key_verify(app_pk, claim_pk, exp)) ==> event(jwt_claim_signing_key_create(app_pk, claim_pk, exp)).

(* Query: JWT server-cert-claim authenticity.
   True  = every verified cert claim has a matching creation event.
   False = a cert claim can be verified without being legitimately created. *)
query claim_pk: pkey, subject_and_san: bitstring, issuer: bitstring, exp: timestamp;
  event(jwt_server_cert_claim_verify(claim_pk, subject_and_san, issuer, exp)) ==> event(jwt_server_cert_claim_create(claim_pk, subject_and_san, issuer, exp)).

(* Query: Client-side rejection of rogue TLS session.
   True  = client can reject mismatched issuer/session.
   False = rejection event never occurs in this model. *)
query event(app_terminated_rogue(server_hostname, server_cert_subject_and_san, rogue_cert_issuer)).

query  sens_d: bitstring, rc: bitstring, pkc: pkey, rs: bitstring, pks: pkey;
  event(real_server_accepted(server_hostname, 
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, server_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, server_cert_issuer), gen_sk_for_id(real_server)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, server_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, server_cert_issuer), gen_sk_for_id(real_server))))).

query  sens_d: bitstring, rc: bitstring, pkc: pkey, rs: bitstring, pks: pkey;
  event(app_accepted(server_hostname, 
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, server_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, server_cert_issuer), gen_sk_for_id(real_server)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, server_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, server_cert_issuer), gen_sk_for_id(real_server))))).

query  sens_d: bitstring, rc: bitstring, pkc: pkey, rs: bitstring, pks: pkey;
  event(rogue_server_accepted(server_hostname, 
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_server)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_server))))).

query  sens_d: bitstring, rc: bitstring, pkc: pkey, rs: bitstring, pks: pkey;
  event(real_server_accepted(server_hostname, 
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, server_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, server_cert_issuer), gen_sk_for_id(real_server)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, server_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, server_cert_issuer), gen_sk_for_id(real_server)))))
  ==>
  event(app_accepted(server_hostname, 
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, server_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, server_cert_issuer), gen_sk_for_id(real_server)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, server_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, server_cert_issuer), gen_sk_for_id(real_server)))))
  .
query  sens_d: bitstring;
event(app_tricked(server_hostname, server_cert_subject_and_san, rogue_cert_issuer, sens_d)).


query trans: bitstring, sens_d: bitstring;
event(app_tricked(server_hostname, server_cert_subject_and_san, rogue_cert_issuer, sens_d))
  ==>
event(rogue_server_accepted(
  server_hostname,
  trans,
  sens_d,
  gen_cert(
    pk(gen_sk_for_id(rogue_server)),
    server_cert_subject_and_san,
    rogue_cert_issuer,
    sig_sign(
      cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer),
      gen_sk_for_id(rogue_server)
    )
  )
)).

process
  (!RealServer) | (!BGPHijackingRogueServer) | (!LegitimateApp) 
