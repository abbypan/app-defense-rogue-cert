set attacker = active.
(* set attacker = passive. *)

(* This file is intended to be checked with declarations in base.pvl. *)

free c_client: channel [private].
free c_server: channel [private].

let RealServer =
  in(c_server, pk_c: pkey);
  out(c_server, server_hello(
      server_hostname,
      server_ip,
      server_mechine,
      server_cert_subject_and_san,
      server_cert_issuer,
      pk(sk_real_server_cert),
      pk(sk_real_server_cert)
  ));
  event real_server_sent(server_hostname, server_cert_subject_and_san, server_cert_issuer, pk(sk_real_server_cert));
  in(c_server, sens_cipher: bitstring);
  let ss = shared_secret(sk_real_server_temp, pk_c) in
  let sens_d = dec_data(ss, sens_cipher) in
  event real_server_recv(sens_d).

(* In-path MITM adversary:
   monitors client->server and server->client traffic,
   then substitutes the legitimate server response with a rogue-cert response. *)
let MitmServer =
  in(c_client, pk_c: pkey);
  event mitm_monitors_client(pk_c);
  out(c_server, pk(sk_rogue_server_temp));
  in(c_server, server_hello(hostn_s, sip_s, smech_s, san_s, iss_s, pk_srv, cert_pk_srv));
  event mitm_monitors_server(hostn_s, san_s, iss_s, pk_srv);
  let rogue_msg = server_hello(
      hostn_s,
      rogue_ip,
      rogue_mechine,
      san_s,
      rogue_cert_issuer,
      pk(sk_rogue_server_temp),
      pk(sk_rogue_server_cert)
  ) in
  event mitm_replaced_response(hostn_s, san_s, rogue_cert_issuer, pk(sk_rogue_server_temp));
  out(c_client, rogue_msg);
  in(c_client, sens_cipher: bitstring);
  let ss_mitm = shared_secret(sk_rogue_server_temp, pk_c) in
  let sens_d = dec_data(ss_mitm, sens_cipher) in
  let ss_mitm_s = shared_secret(sk_rogue_server_temp, pk_srv) in
  let sens_cipher_s = enc_data(ss_mitm_s, sens_d) in
  out(c_server, sens_cipher_s);
  event mitm_intercepted(hostn_s, san_s, rogue_cert_issuer, sens_d).

let LegitimateApp =
  out(c_client, pk(sk_app_temp));
  in(c_client, server_hello(hostn, sip, smech, subj_and_san_recv, iss, pk_s, cert_pk_s));
  let ss = shared_secret(sk_app_temp, pk_s) in
  let sens_cipher = enc_data(ss, sensitive_data) in
  if (check_host(hostn, subj_and_san_recv) = host_true) &&
     (check_issuer(iss, system_ca_list) = issuer_true) &&
     (check_cert_pk(iss, cert_pk_s) = cert_pk_true) &&
     (check_temp_pk(cert_pk_s, pk_s) = temp_pk_true) 
      then
    out(c_client, sens_cipher);
    event app_accepted(hostn, subj_and_san_recv, iss, sensitive_data);
    if iss = rogue_cert_issuer then
      event app_tricked(hostn, subj_and_san_recv, iss, sensitive_data)
.


query attacker(sensitive_data).

(* Query 1: MITM attack reachability with rogue cert.
   True  = there exists an execution where MITM decrypts client sensitive data.
   False = this modeled MITM interception path is not reachable. *)
query event(mitm_intercepted(server_hostname, server_cert_subject_and_san, rogue_cert_issuer, sensitive_data)).


(* Query 2: MITM attack acceptance with rogue cert.
   True  = there exists an execution where the client accepts a server response signed with the rogue_cert_issuer and sends sensitive_data to the MITM endpoint.
   False = the modeled MITM attacker cannot trigger the client to accept a rogue certificate and send sensitive data in this path. *)
query event(app_tricked(server_hostname, server_cert_subject_and_san, rogue_cert_issuer, sensitive_data)).


process
  (!RealServer) | (!MitmServer) | (!LegitimateApp)
