(*
 * ASPin claim-cache and CA-migration model.
 *
 * This model corresponds to paper_content.tex, Section sec:cache.
 * It proves safety and successful reachability under server availability.
 * As in any Dolev-Yao model, an active attacker can always cause denial of
 * service by dropping all messages; network availability itself is therefore
 * an explicit assumption rather than a claimed security property.
 *
 * Windows:
 *   w0  CurrCert + claim(CurrCA)
 *   w1  CurrCert + transitional claim(CurrCA, NewCA)
 *   w2  CurrCert + renewed transitional claim (second expiration window)
 *   w3  NewCert  + cached transitional claim
 *   w4  NewCert  + final claim(NewCA)
 *)

const new_cert_issuer: bitstring.

const window_setup: bitstring.
const window_current: bitstring.
const window_overlap_1: bitstring.
const window_overlap_2: bitstring.
const window_new_cert: bitstring.
const window_final: bitstring.

const time_setup: timestamp.
const time_current: timestamp.
const time_overlap_1: timestamp.
const time_overlap_2: timestamp.
const time_final: timestamp.

const policy_current_ca: bitstring.
const policy_transition_ca: bitstring.
const policy_new_ca: bitstring.

fun migration_claim(bitstring, bitstring): bitstring [data].
reduc forall subject_and_san: bitstring, policy: bitstring;
      get_migration_subject_and_san(migration_claim(subject_and_san, policy)) =
      subject_and_san.
reduc forall subject_and_san: bitstring, policy: bitstring;
      get_migration_policy(migration_claim(subject_and_san, policy)) = policy.

reduc issuer_allowed(real_cert_issuer, policy_current_ca) = true;
      issuer_allowed(real_cert_issuer, policy_transition_ca) = true;
      issuer_allowed(new_cert_issuer, policy_transition_ca) = true;
      issuer_allowed(new_cert_issuer, policy_new_ca) = true.

event MigrationClaimPublished(bitstring, bitstring, timestamp).
event MigrationClaimCached(bitstring, bitstring, timestamp).
event MigrationWindowComplete(bitstring).
event MigrationCertAccepted(bitstring, bitstring, bitstring).

let MigrationServer =
  let sk_app_signing = gen_sk_for_id(app_signing) in
  let sk_claim_signing = gen_sk_for_id(claim_signing) in

  (* Authenticate K_cpub with the app signing key. *)
  let key_header = pk2s(pk(sk_app_signing)) in
  let key_exp = succ_t(time_setup) in
  let key_ttl = ttl_one in
  let key_content = pk2s(pk(sk_claim_signing)) in
  let token_k = jwt_sign(key_header, key_content, key_exp, key_ttl, sk_app_signing) in
  event ClaimKeySign(sk_app_signing, pk(sk_claim_signing), key_exp);
  out(c, token_k);

  (* Window w0: current certificate and current-CA-only claim. *)
  let exp_current = succ_t(time_current) in
  let claim_current =
      migration_claim(server_cert_subject_and_san, policy_current_ca) in
  let token_current =
      jwt_sign(pk2s(pk(sk_claim_signing)), claim_current, exp_current,
               ttl_one, sk_claim_signing) in
  event MigrationClaimPublished(window_current, policy_current_ca, exp_current);
  out(c, token_current);

  (* Window w1: publish transition before changing the certificate. *)
  let exp_overlap_1 = succ_t(time_overlap_1) in
  let claim_overlap_1 =
      migration_claim(server_cert_subject_and_san, policy_transition_ca) in
  let token_overlap_1 =
      jwt_sign(pk2s(pk(sk_claim_signing)), claim_overlap_1, exp_overlap_1,
               ttl_two, sk_claim_signing) in
  event MigrationClaimPublished(
      window_overlap_1, policy_transition_ca, exp_overlap_1);
  out(c, token_overlap_1);

  (* Window w2: renew and retain the transition for a second expiration window. *)
  let exp_overlap_2 = succ_t(time_overlap_2) in
  let claim_overlap_2 =
      migration_claim(server_cert_subject_and_san, policy_transition_ca) in
  let token_overlap_2 =
      jwt_sign(pk2s(pk(sk_claim_signing)), claim_overlap_2, exp_overlap_2,
               ttl_two, sk_claim_signing) in
  event MigrationClaimPublished(
      window_overlap_2, policy_transition_ca, exp_overlap_2);
  out(c, token_overlap_2);

  (* Window w4: after NewCert deployment, converge to NewCA-only policy. *)
  let exp_final = succ_t(time_final) in
  let claim_final =
      migration_claim(server_cert_subject_and_san, policy_new_ca) in
  let token_final =
      jwt_sign(pk2s(pk(sk_claim_signing)), claim_final, exp_final,
               ttl_one, sk_claim_signing) in
  event MigrationClaimPublished(window_final, policy_new_ca, exp_final);
  out(c, token_final)
  .

let UpdatingApp =
  (* ClaimKeyVerify *)
  in(c, jwt(kh: bitstring, kp: bitstring, ks: bitstring));
  let pk_app_signing = pk(gen_sk_for_id(app_signing)) in
  let claim_key = s2pk(get_content(kp)) in
  let key_exp_recv = get_exp(kp) in
  let key_ttl_recv = get_ttl(kp) in
  let true = jwt_verify(jwt(kh, kp, ks), pk_app_signing, time_setup) in
  let true = key_ttl_recv = ttl_one in
  event ClaimKeyVerify(pk_app_signing, claim_key, key_exp_recv);

  (* w0: cache CurrCA and accept CurrCert. *)
  in(c, jwt(h0: bitstring, p0: bitstring, s0: bitstring));
  let content0 = get_content(p0) in
  let policy0 = get_migration_policy(content0) in
  let exp0 = get_exp(p0) in
  let ttl0 = get_ttl(p0) in
  let true = jwt_verify(jwt(h0, p0, s0), claim_key, time_current) in
  let true = ttl0 = ttl_one in
  event MigrationClaimCached(window_current, policy0, exp0);
  let true =
      check_host(server_hostname, get_migration_subject_and_san(content0)) in
  let true = issuer_allowed(real_cert_issuer, policy0) in
  event MigrationCertAccepted(window_current, real_cert_issuer, policy0);
  event MigrationWindowComplete(window_current);

  (* w1: refresh transition claim while CurrCert remains deployed. *)
  in(c, jwt(h1: bitstring, p1: bitstring, s1: bitstring));
  let content1 = get_content(p1) in
  let policy1 = get_migration_policy(content1) in
  let exp1 = get_exp(p1) in
  let ttl1 = get_ttl(p1) in
  let true = jwt_verify(jwt(h1, p1, s1), claim_key, time_overlap_1) in
  let true = ttl1 = ttl_two in
  event MigrationClaimCached(window_overlap_1, policy1, exp1);
  let true =
      check_host(server_hostname, get_migration_subject_and_san(content1)) in
  let true = issuer_allowed(real_cert_issuer, policy1) in
  event MigrationCertAccepted(window_overlap_1, real_cert_issuer, policy1);
  event MigrationWindowComplete(window_overlap_1);

  (* w2: cache the renewed transition claim for late clients. *)
  in(c, jwt(h2: bitstring, p2: bitstring, s2: bitstring));
  let content2 = get_content(p2) in
  let policy2 = get_migration_policy(content2) in
  let exp2 = get_exp(p2) in
  let ttl2 = get_ttl(p2) in
  let true = jwt_verify(jwt(h2, p2, s2), claim_key, time_overlap_2) in
  let true = ttl2 = ttl_two in
  event MigrationClaimCached(window_overlap_2, policy2, exp2);
  let true =
      check_host(server_hostname, get_migration_subject_and_san(content2)) in
  let true = issuer_allowed(real_cert_issuer, policy2) in
  event MigrationCertAccepted(window_overlap_2, real_cert_issuer, policy2);
  event MigrationWindowComplete(window_overlap_2);

  (* w3: deploy NewCert only after the two overlap refresh windows. *)
  let true =
      check_host(server_hostname, get_migration_subject_and_san(content2)) in
  let true = issuer_allowed(new_cert_issuer, policy2) in
  event MigrationCertAccepted(window_new_cert, new_cert_issuer, policy2);
  event MigrationWindowComplete(window_new_cert);

  (* w4: cache NewCA-only claim and continue accepting NewCert. *)
  in(c, jwt(h4: bitstring, p4: bitstring, s4: bitstring));
  let content4 = get_content(p4) in
  let policy4 = get_migration_policy(content4) in
  let exp4 = get_exp(p4) in
  let ttl4 = get_ttl(p4) in
  let true = jwt_verify(jwt(h4, p4, s4), claim_key, time_final) in
  let true = ttl4 = ttl_one in
  event MigrationClaimCached(window_final, policy4, exp4);
  let true =
      check_host(server_hostname, get_migration_subject_and_san(content4)) in
  let true = issuer_allowed(new_cert_issuer, policy4) in
  event MigrationCertAccepted(window_final, new_cert_issuer, policy4);
  event MigrationWindowComplete(window_final)
  .

(* Every published claim accepted by the app was created by the migration server. *)
query w: bitstring, policy: bitstring, exp: timestamp;
  event(MigrationClaimCached(w, policy, exp)) ==>
  event(MigrationClaimPublished(w, policy, exp)).

(* Each cache/update window and its legitimate connection are reachable. *)
query event(MigrationWindowComplete(window_current)).
query event(MigrationWindowComplete(window_overlap_1)).
query event(MigrationWindowComplete(window_overlap_2)).
query event(MigrationWindowComplete(window_new_cert)).
query event(MigrationWindowComplete(window_final)).

query event(MigrationCertAccepted(
    window_current, real_cert_issuer, policy_current_ca)).
query event(MigrationCertAccepted(
    window_overlap_1, real_cert_issuer, policy_transition_ca)).
query event(MigrationCertAccepted(
    window_overlap_2, real_cert_issuer, policy_transition_ca)).
query event(MigrationCertAccepted(
    window_new_cert, new_cert_issuer, policy_transition_ca)).
query event(MigrationCertAccepted(
    window_final, new_cert_issuer, policy_new_ca)).

(* Completion of each window implies that its legitimate certificate was
 * accepted. In particular, NewCert cannot complete with a stale CurrCA-only
 * policy: it requires the cached transition policy. *)
query event(MigrationWindowComplete(window_current)) ==>
  event(MigrationCertAccepted(
      window_current, real_cert_issuer, policy_current_ca)).
query event(MigrationWindowComplete(window_overlap_1)) ==>
  event(MigrationCertAccepted(
      window_overlap_1, real_cert_issuer, policy_transition_ca)).
query event(MigrationWindowComplete(window_overlap_2)) ==>
  event(MigrationCertAccepted(
      window_overlap_2, real_cert_issuer, policy_transition_ca)).
query event(MigrationWindowComplete(window_new_cert)) ==>
  event(MigrationCertAccepted(
      window_new_cert, new_cert_issuer, policy_transition_ca)).
query event(MigrationWindowComplete(window_final)) ==>
  event(MigrationCertAccepted(
      window_final, new_cert_issuer, policy_new_ca)).

process
  (!MigrationServer) | (!UpdatingApp)
