let RealServer =
  let sk_app_signing = gen_sk_for_id(app_signing) in
  let sk_claim_signing = gen_sk_for_id(claim_signing) in
  
 
  
  let header = pk2s(pk(sk_app_signing)) in
  let good_exp = succ_t(curr) in
  let content = pk2s(pk(sk_claim_signing)) in
  let token = jwt_sign(header, content, good_exp, sk_app_signing) in
  event ClaimKeySign(sk_app_signing, pk(sk_claim_signing), good_exp);
  out(cs, token);

  let header2 = pk2s(pk(sk_claim_signing)) in
  let good_exp2 = succ_t(curr) in
  let content2 = cert_claim(server_cert_subject_and_san, real_cert_issuer) in
  let token2 = jwt_sign(header2, content2, good_exp2, sk_claim_signing) in
  event CertClaimSign(sk_claim_signing, server_cert_subject_and_san, real_cert_issuer, good_exp2);
  out(cs, token2);
  
  in(cs, client_hello(rand_c, pk_c));
  let c_hello = client_hello(rand_c, pk_c) in
  let sk_real_server_cert = gen_sk_for_id(real_server) in
  let sk_real_issuer = gen_sk_for_id(real_cert_issuer) in
  let real_s_cert_sig = sig_sign(cert_content(pk(sk_real_server_cert), server_cert_subject_and_san, real_cert_issuer), 
  sk_real_issuer) in
  let real_s_cert = gen_cert(pk(sk_real_server_cert),
  server_cert_subject_and_san,
  real_cert_issuer,
  real_s_cert_sig
   ) in

  new sk_real_server_temp: skey;
  new random_real_server: bitstring;
   let real_s_hello = server_hello(random_real_server, pk(sk_real_server_temp)) in
  let trans = transcript_hash(c_hello, real_s_hello, real_s_cert) in
  let s_handshake_sig = sig_sign(trans, sk_real_server_cert) in
  out(cs, server_hello_handshake(server_hostname, server_ip, server_mechine, real_s_hello, real_s_cert, s_handshake_sig));

  let ss = session_key(server_shared_secret(sk_real_server_temp, pk_c), trans) in
 
  in(cs, sens_cipher: bitstring);
  if check_authtag(ss, sens_cipher) = true
  then (
  event RSConn(server_hostname, trans, dec_data(ss, sens_cipher), real_s_cert, sens_cipher)
  )
  .

let MitmServer =
  new sk_rogue_server_temp: skey;
  in(cs, jwt(hm1: bitstring, plrm1: bitstring, srm1: bitstring));
  out(cc, jwt(hm1, plrm1, srm1));
  in(cs, jwt(hm2: bitstring, plrm2: bitstring, srm2: bitstring));
  out(cc, jwt(hm2, plrm2, srm2));

  in(cc, client_hello(rand_c, pk_c));
  
  let rogue_c_hello = client_hello(rand_c, pk(sk_rogue_server_temp)) in
  out(cs, rogue_c_hello);
  in(cs, server_hello_handshake(hostn_s, sip_s, smech_s, server_hello(rand_s, pk_srv), gen_cert(cert_pk_srv, san_s, iss_s, cert_sig_srv), s_handshake_sig_s));
  let real_s_hello = server_hello(rand_s, pk_srv) in
  let real_s_cert = gen_cert(cert_pk_srv, san_s, iss_s, cert_sig_srv) in
  
  let rogue_cert_sig = sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), san_s, rogue_cert_issuer), gen_sk_for_id(rogue_cert_issuer)) in
  let rogue_s_cert = gen_cert(pk(gen_sk_for_id(rogue_server)), san_s, rogue_cert_issuer, rogue_cert_sig) in
  
  let rogue_s_hello = server_hello(rand_s, pk(sk_rogue_server_temp)) in
  let trans_mitm_c = transcript_hash(client_hello(rand_c, pk_c), rogue_s_hello, rogue_s_cert) in
  let rogue_s_handshake_sig = sig_sign(trans_mitm_c, gen_sk_for_id(rogue_server)) in
  out(cc, server_hello_handshake(hostn_s, rogue_ip, rogue_mechine, rogue_s_hello, rogue_s_cert, rogue_s_handshake_sig));

  in(cc, sens_cipher: bitstring);
  let ss_mitm_c = session_key(server_shared_secret(sk_rogue_server_temp, pk_c), trans_mitm_c) in
  if check_authtag(ss_mitm_c, sens_cipher) = true
  then (
    let sens_d = dec_data(ss_mitm_c, sens_cipher) in
    event MSFakeServer(hostn_s, trans_mitm_c, sens_d, rogue_s_cert, sens_cipher);

    let trans_mitm_s = transcript_hash(
      rogue_c_hello,
      real_s_hello,
      real_s_cert
    ) in
    let ss_mitm_s = session_key(client_shared_secret(sk_rogue_server_temp, pk_srv), trans_mitm_s) in
    let sens_cipher2 = enc_data(ss_mitm_s, sens_d) in
   
    event MSFakeClient(hostn_s, trans_mitm_s, sens_d, real_s_cert, sens_cipher2);
     out(cs, sens_cipher2)
  )
  .

let LegitimateApp =
  new sk_app_temp: skey;
  new random_app: bitstring;
  new sensitive_data: bitstring;
  in(cc, jwt(h: bitstring, plr: bitstring, sr: bitstring));
  let pk_app_signing = pk(gen_sk_for_id(app_signing)) in
  let content = get_content(plr) in
  let pk1_recv = s2pk(content) in
  let exp_recv = get_exp(plr) in
  if jwt_verify(jwt(h, plr, sr), pk_app_signing, curr) = true then
      event ClaimKeyVerify(pk_app_signing, pk1_recv, exp_recv);
 
  in(cc, jwt(h2: bitstring, plr2: bitstring, sr2: bitstring));
  let content2 = get_content(plr2) in
  let subject_and_san2 = get_subject_and_san(content2) in
  let issuer2 = get_issuer(content2) in
  let exp2 = get_exp(plr2) in
  if jwt_verify(jwt(h2, plr2, sr2), pk1_recv, curr) = true then
      event CertClaimVerify(pk1_recv, subject_and_san2, issuer2, exp2);
  
  let c_hello = client_hello(random_app, pk(sk_app_temp)) in
  out(cc, c_hello);
 
  in(cc, 
  server_hello_handshake(hostn, sip, smech, server_hello(rand_s, pk_recv), 
  gen_cert(cert_pk_recv, subj_and_san_recv, iss, cert_sig_recv),
  s_handshake_sig)
  );
  let s_hello = server_hello(rand_s, pk_recv) in
  let s_cert = gen_cert(cert_pk_recv, subj_and_san_recv, iss, cert_sig_recv) in
  let trans = transcript_hash(client_hello(random_app, pk(sk_app_temp)), 
  server_hello(rand_s, pk_recv),
  s_cert)
   in

  
    

 if  (check_host(hostn, subj_and_san_recv) = host_true) &&
     (sig_verify(cert_content(cert_pk_recv, subj_and_san_recv, iss), cert_sig_recv, pk(gen_sk_for_id(iss))) = true) &&
     (check_issuer(iss, system_ca_list) = issuer_true) &&
     (sig_verify(trans, s_handshake_sig, cert_pk_recv) = true) &&
     (check_host(hostn, subject_and_san2) = host_true) &&
     (issuer2 = iss)
      then
    (
      let ss = session_key(client_shared_secret(sk_app_temp, pk_recv), trans) in
      if iss = real_cert_issuer then (
        event AppConnRS(hostn, trans, sensitive_data, s_cert, enc_data(ss, sensitive_data));
        out(cc, enc_data(ss, sensitive_data))
      )
      else if iss = rogue_cert_issuer then (
        event AppConnMS(hostn, trans, sensitive_data, s_cert, enc_data(ss, sensitive_data));
        out(cc, enc_data(ss, sensitive_data))
      )
    )
    else
      event AppRejectConn(hostn, subj_and_san_recv, iss)
      .

(* Query introduction:
   Each query asks whether a security property is reachable or guaranteed.
   ProVerif returns:
   - True  = the stated property holds in all executions of this model.
   - False = ProVerif found a counterexample/attack trace. *)

(* Query: JWT claim-signing-key verification reachability.
   True  = the app can verify the claim-signing key token from app_signing.
   False = this JWT verification path is unreachable. *)
query exp_recv: timestamp;
  event(ClaimKeyVerify(pk(gen_sk_for_id(app_signing)), pk(gen_sk_for_id(claim_signing)), exp_recv)).

query exp_recv: timestamp;
  event(ClaimKeySign(gen_sk_for_id(app_signing), pk(gen_sk_for_id(claim_signing)), exp_recv)).

(* Query: JWT key-chain authenticity.
   True  = every verification event has a matching creation event by RealServer.
   False = some verified claim-signing key has no matching creation event. *)
query app_sk: skey, claim_pk: pkey, exp: timestamp;
  event(ClaimKeyVerify(pk(app_sk), claim_pk, exp)) ==> event(ClaimKeySign(app_sk, claim_pk, exp)).

(* Query: JWT server-cert-claim verification reachability.
   True  = the app can verify the real server certificate claim from claim_signing.
   False = this JWT server-cert-claim verification path is unreachable. *)
query exp2: timestamp;
  event(CertClaimVerify(pk(gen_sk_for_id(claim_signing)), server_cert_subject_and_san, real_cert_issuer, exp2)).

  query exp2: timestamp;
  event(CertClaimSign(gen_sk_for_id(claim_signing), server_cert_subject_and_san, real_cert_issuer, exp2)).


(* Query: JWT server-cert-claim authenticity.
   True  = every verified cert claim has a matching creation event.
   False = a cert claim can be verified without being legitimately created. *)
query claim_sk: skey, subject_and_san: bitstring, issuer: bitstring, exp: timestamp;
  event(CertClaimVerify(pk(claim_sk), subject_and_san, issuer, exp)) ==> event(CertClaimSign(claim_sk, subject_and_san, issuer, exp)).


(* Query: Real-server receive path reachability.
   True  = there exists a trace where RealServer accepts/decrypts client data for the modeled legitimate transcript.
   False = this modeled RealServer acceptance path is unreachable. *)
query  sens_d: bitstring, sens_cipher: bitstring, rc: bitstring, pkc: pkey, rs: bitstring, pks: pkey;
  event(RSConn(server_hostname,
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer))), sens_cipher)).

(* Query: Client acceptance path reachability.
   True  = there exists a trace where the app accepts the modeled legitimate transcript and sends ciphertext.
   False = this modeled app-acceptance path is unreachable. *)
query  sens_d: bitstring, sens_cipher: bitstring, rc: bitstring, pkc: pkey, rs: bitstring, pks: pkey;
  event(AppConnRS(server_hostname, 
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer))), sens_cipher)).


(* Query: Real-server implies app-accepted correspondence.
   True  = whenever RealServer accepts the modeled legitimate transcript, the app also accepted it.
   False = there is a trace where RealServer connects but AppConnRS does not occur. *)
query  sens_d: bitstring, sens_cipher: bitstring, rc: bitstring, pkc: pkey, rs: bitstring, pks: pkey;
  event(RSConn(server_hostname,
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer))), sens_cipher))
  ==>
  event(AppConnRS(server_hostname, 
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer))), sens_cipher))
  .


(* Query: Client-side rejection of rogue TLS session.
   True  = client can reject mismatched issuer/session.
   False = rejection event never occurs in this model. *)
query event(AppRejectConn(server_hostname, server_cert_subject_and_san, rogue_cert_issuer)).

(* Query: MITM interception reachability.
   True  = there exists a trace where the MITM endpoint decrypts client data.
   False = interception/decryption is unreachable in this model. *)
query trans: bitstring, sens_d: bitstring, sens_cipher: bitstring;
  event(MSFakeServer(server_hostname, trans, sens_d, gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_cert_issuer))), sens_cipher)).

  (* Query: MITM interception reachability.
   True  = there exists a trace where the MITM endpoint decrypts client data.
   False = interception/decryption is unreachable in this model. *)
query trans: bitstring, sens_d: bitstring, sens_cipher: bitstring;
  event(MSFakeClient(server_hostname, trans, sens_d, gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer))), sens_cipher)).


(* Query: Client acceptance path reachability.
   True  = there exists a trace where the app accepts the modeled rogue transcript and sends ciphertext.
   False = this modeled app-acceptance path is unreachable. *)
query  sens_d: bitstring, sens_cipher: bitstring, rc: bitstring, pkc: pkey, rs: bitstring, pks: pkey;
  event(AppConnMS(server_hostname, 
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_cert_issuer))), sens_cipher)).


  (* Query: Client acceptance path reachability.
   True  = there exists a trace where the app accepts the modeled rogue transcript and sends ciphertext.
   False = this modeled app-acceptance path is unreachable. *)
query  sens_d: bitstring, sens_cipher: bitstring, rc: bitstring, pkc: pkey, rs: bitstring, pks: pkey;
event(MSFakeServer(server_hostname,
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_cert_issuer))), sens_cipher)) ==>
  event(AppConnMS(server_hostname, 
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(rogue_server)), server_cert_subject_and_san, rogue_cert_issuer), gen_sk_for_id(rogue_cert_issuer))), sens_cipher)).

query  sens_d: bitstring, sens_cipher: bitstring, rc: bitstring, pkc: pkey, rs: bitstring, pks: pkey;

  event(RSConn(server_hostname,
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer))), sens_cipher))
   ==>
  event(MSFakeClient(server_hostname,
  transcript_hash(
  client_hello(rc, pkc), 
  server_hello(rs, pks),
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer)))
  ),
  sens_d, 
  gen_cert(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer, sig_sign(cert_content(pk(gen_sk_for_id(real_server)), server_cert_subject_and_san, real_cert_issuer), gen_sk_for_id(real_cert_issuer))), sens_cipher)).

process
  (!RealServer) | (!MitmServer) | (!LegitimateApp)
