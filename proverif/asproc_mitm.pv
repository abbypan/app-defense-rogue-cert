set attacker = active.
(*set attacker = passive.*)

free c_client: channel [private].
free c_server: channel [private].

(* events *)
event jwt_claim_signing_key_create(pkey, pkey, timestamp).
event jwt_claim_signing_key_verify(pkey, pkey, timestamp).
event jwt_server_cert_claim_create(pkey, bitstring, bitstring, timestamp).
event jwt_server_cert_claim_verify(pkey, bitstring, bitstring, timestamp).

event app_server_tls(bitstring, bitstring, bitstring, bitstring).
event app_client_tls(bitstring, bitstring, bitstring, bitstring).
event app_mitm_intercepted(bitstring, bitstring, bitstring, bitstring).
event app_reject_mitm_intercepted(bitstring, bitstring, bitstring, bitstring).

event mitm_monitors_client(pkey).
event mitm_monitors_server(bitstring, bitstring, bitstring, pkey).
event mitm_replaced_response(bitstring, bitstring, bitstring, pkey).

let AppServer =
  let header = pk2s(pk(sk_app_signing)) in
  let good_exp = succ_t(curr) in
  let content = pk2s(pk(sk_claim_signing)) in
  let token = jwt_sign(header, content, good_exp, sk_app_signing) in
  event jwt_claim_signing_key_create(pk(sk_app_signing), pk(sk_claim_signing), good_exp);
  out(c, token);

  let header2 = pk2s(pk(sk_claim_signing)) in
  let good_exp2 = succ_t(curr) in
  let content2 = cert_claim(server_cert_subject_and_san, server_cert_issuer) in
  let token2 = jwt_sign(header2, content2, good_exp2, sk_claim_signing) in
  event jwt_server_cert_claim_create(pk(sk_claim_signing), server_cert_subject_and_san, server_cert_issuer, good_exp2);
  out(c, token2);

  in(c_server, pk_c: pkey);
  out(c_server, tls_server(
      server_hostname, server_ip, server_mechine, server_cert_subject_and_san, server_cert_issuer, pk(sk_real_server_temp)
  ));
  in(c_server, sens_cipher: bitstring);
  let ss = shared_secret(sk_real_server_temp, pk_c) in
  let sens_d = dec_data(ss, sens_cipher) in
  event app_server_tls(server_hostname, server_cert_subject_and_san, server_cert_issuer, sens_d).

(* In-path MITM adversary:
   forwards client key-share to server, replaces server hello with rogue issuer/key,
   and then decrypts client ciphertext destined to rogue key. *)
let MitmServer =
  in(c_client, pk_c: pkey);
  event mitm_monitors_client(pk_c);
  out(c_server, pk(sk_rogue_server_temp));
  in(c_server, tls_server(hostn_s, sip_s, smech_s, san_s, iss_s, pk_srv));
  event mitm_monitors_server(hostn_s, san_s, iss_s, pk_srv);
  out(c_client, tls_server(
      hostn_s, rogue_ip, rogue_mechine, san_s, rogue_cert_issuer, pk(sk_rogue_server_temp)
  ));
  event mitm_replaced_response(hostn_s, san_s, rogue_cert_issuer, pk(sk_rogue_server_temp));
  in(c_client, sens_cipher: bitstring);
 
  let ss_mitm = shared_secret(sk_rogue_server_temp, pk_c) in
  let sens_d = dec_data(ss_mitm, sens_cipher) in
   let ss_mitm_s = shared_secret(sk_rogue_server_temp, pk_srv) in
  let sens_cipher_s = enc_data(ss_mitm_s, sens_d) in
  out(c_server, sens_cipher_s);
  event app_mitm_intercepted(server_hostname, server_cert_subject_and_san, rogue_cert_issuer, sens_d).

let LegitimateApp =
  in(c, jwt(h: bitstring, plr: bitstring, sr: bitstring));
  let pk_app_signing = pk(sk_app_signing) in
  let content = get_content(plr) in
  let pk1_recv = s2pk(content) in
  let exp_recv = get_exp(plr) in
  if jwt_verify(jwt(h, plr, sr), pk_app_signing, curr) = true then
      event jwt_claim_signing_key_verify(pk(sk_app_signing), pk1_recv, exp_recv);

  in(c, jwt(h2: bitstring, plr2: bitstring, sr2: bitstring));
  let content2 = get_content(plr2) in
  let subject_and_san2 = get_subject_and_san(content2) in
  let issuer2 = get_issuer(content2) in
  let exp2 = get_exp(plr2) in
  if jwt_verify(jwt(h2, plr2, sr2), pk1_recv, curr) = true then
      event jwt_server_cert_claim_verify(pk1_recv, subject_and_san2, issuer2, exp2);

  out(c_client, pk(sk_app_temp));
  in(c_client, tls_server(hostn, sip, smech, subj_and_san_recv, iss, pk_recv));
  let ss = shared_secret(sk_app_temp, pk_recv) in
  let sens_cipher = enc_data(ss, sensitive_data) in
  if (check_host(hostn, subject_and_san2) = host_true) &&
     (check_host(hostn, subj_and_san_recv) = host_true) &&
     (check_issuer(iss, system_ca_list) = issuer_true) then
    if (is_same_issuer(issuer2, iss) = same_issuer_true) then
      out(c_client, sens_cipher);
      event app_client_tls(hostn, subj_and_san_recv, iss, sensitive_data)
    else
      event app_reject_mitm_intercepted(hostn, subj_and_san_recv, iss, sensitive_data).

(* Query: JWT key-chain authenticity.
   True  = every verification event has a matching creation event by AppServer.
   False = some verified claim-signing key has no matching creation event. *)
query app_pk: pkey, claim_pk: pkey, exp: timestamp;
  event(jwt_claim_signing_key_verify(app_pk, claim_pk, exp)) ==> event(jwt_claim_signing_key_create(app_pk, claim_pk, exp)).

(* Query: JWT server-cert-claim authenticity.
   True  = every verified cert claim has a matching creation event.
   False = a cert claim can be verified without being legitimately created. *)
query claim_pk: pkey, subject_and_san: bitstring, issuer: bitstring, exp: timestamp;
  event(jwt_server_cert_claim_verify(claim_pk, subject_and_san, issuer, exp)) ==> event(jwt_server_cert_claim_create(claim_pk, subject_and_san, issuer, exp)).

(* Query: Secrecy of application payload.
   True  = attacker can derive sensitive_data (secrecy broken).
   False = attacker cannot derive sensitive_data (secrecy preserved). *)
query attacker(sensitive_data).

(* Query: Intended legitimate TLS acceptance.
   True  = there exists a trace where client accepts legitimate server issuer/payload.
   False = intended legitimate acceptance trace is unreachable. *)
query event(app_client_tls(server_hostname, server_cert_subject_and_san, server_cert_issuer, sensitive_data)).

(* Query: MITM interception reachability.
   True  = MITM decrypts sensitive_data after replacing server issuer/key.
   False = modeled MITM interception path is unreachable. *)
query event(app_mitm_intercepted(server_hostname, server_cert_subject_and_san, rogue_cert_issuer, sensitive_data)).

(* Query: Rejection of issuer mismatch.
   True  = client rejects rogue-issuer server response.
   False = rejection path is unreachable. *)
query event(app_reject_mitm_intercepted(server_hostname, server_cert_subject_and_san, rogue_cert_issuer, sensitive_data)).

(* Query: Monitoring sanity.
   True  = interception implies MITM observed client key-share.
   False = interception can happen without expected monitor event. *)
query event(app_mitm_intercepted(server_hostname, server_cert_subject_and_san, rogue_cert_issuer, sensitive_data)) ==>
      event(mitm_monitors_client(pk(sk_app_temp))).

(* Query: Correspondence to app server receive.
   True  = intercepted payload still matches app-server received sensitive_data.
   False = MITM key substitution breaks end-to-end payload binding. *)
query event(app_mitm_intercepted(server_hostname, server_cert_subject_and_san, rogue_cert_issuer, sensitive_data)) ==>
      event(app_server_tls(server_hostname, server_cert_subject_and_san, server_cert_issuer, sensitive_data)).

process
  (!AppServer) | (!MitmServer) | (!LegitimateApp)

